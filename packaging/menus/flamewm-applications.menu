<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE Menu PUBLIC "-//freedesktop//DTD Menu 1.0//EN" "http://www.freedesktop.org/standards/menu-spec/menu-1.0.dtd">
<!-- FlameWM application catalog for KService/KSycoca, not a MIME-default database.
     XDG_DATA_HOME and every XDG_DATA_DIRS application directory stay discoverable. -->
<Menu>
  <Name>Applications</Name>
  <DefaultAppDirs/>
  <DefaultDirectoryDirs/>
  <DefaultMergeDirs/>
  <Include><All/></Include>
  <DefaultLayout>
    <Merge type="menus"/>
    <Merge type="files"/>
  </DefaultLayout>
</Menu>
