# Maintainer: ArkFlame Studios <maintainers@arkflame.dev>
pkgname=flamewm-git
pkgver=0.1.3
pkgrel=1
pkgdesc='Rust desktop session and window manager for X11, with a Wayland compositor'
arch=('x86_64')
url='https://github.com/ArkFlame/FlameWM'
license=('LGPL-2.0-only' 'MIT' 'LGPL-3.0-or-later' 'GPL-3.0-only')
depends=(
  'bash'
  'dbus'
  'fontconfig'
  'glibc'
  'libdrm'
  'libgcc'
  'libglvnd'
  'libinput'
  'libpulse'
  'libx11'
  'libxft'
  'libxi'
  'libxkbcommon'
  'mesa'
  'pam'
  'pambase'
  'python'
  'systemd-libs'
  'xorg-xwayland'
)
makedepends=('cargo' 'git' 'pkgconf')
# Arch has no Recommends/Suggests: the Debian Recommends and Suggests fields map here.
# docs/DEPENDENCIES.md is the table of record; tools/test_flamewm_package_dependencies.py checks it.
optdepends=(
  'libxcursor: cursor theme loading'
  'libxext: XShape window masks (rectangle fallback without it)'
  'libxrender: core render extension (fallback without it)'
  'libxcomposite: live backdrop for glass blur'
  'libxdamage: live backdrop damage tracking'
  'wayland: nested Wayland host backend'
  'systemd: systemd-logind seat access for the Wayland DRM session'
  'xdg-utils: open files and links with their default applications'
  'libnotify: Explorer notifications'
  'dunst: notification daemon for the session'
  'xdg-desktop-portal: desktop portals (OpenURI, FileChooser)'
  'xdg-desktop-portal-gtk: fallback portal backend'
  'xorg-xrandr: display layout settings and restore at login'
  'xorg-xprop: deferred XDG autostart after the window manager is ready'
  'dex: XDG autostart entries'
  'ffmpeg: screen recording'
  'imagemagick: desktop Convert wheel'
  'ark: archive extraction from Explorer'
  'zip: archive creation from Explorer'
  'udisks2: mount removable drives from Explorer'
  'curl: weather data fetch in the desktop shell'
  'polkit-gnome: authentication agent for privileged actions'
  'polkit-kde-agent: authentication agent for privileged actions'
  'xdg-desktop-portal-kde: preferred OpenURI and FileChooser portal backend'
  'libxkbcommon-x11: nested --backend=nested compositor inside an X11 session'
  'ttf-ibm-plex: default interface font (falls back to Noto Sans or DejaVu Sans)'
)
provides=("flamewm=${pkgver%%.r*}")
conflicts=('flamewm' 'mcmojave-cursors' 'mcmojave-cursors-git')
backup=('etc/pam.d/flamewm-lock' 'etc/xdg/menus/flamewm-applications.menu')
source=('flamewm::git+https://github.com/ArkFlame/FlameWM.git')
sha256sums=('SKIP')

pkgver() {
  cd flamewm
  printf '%s.r%s.g%s' "$(./scripts/version)" "$(git rev-list --count HEAD)" "$(git rev-parse --short=7 HEAD)"
}

prepare() {
  cd flamewm
  cargo fetch --locked --target "$(rustc --print host-tuple)"
}

build() {
  cd flamewm
  export CARGO_TARGET_DIR=target
  export CARGO_PROFILE_RELEASE_STRIP=false
  cargo build --frozen --release --workspace --features flamewm-wm-wayland/drm
  target/release/flamewm-wayland --capabilities | grep -Fxq 'drm_compiled=true'
}

package() {
  cd flamewm
  CARGO_TARGET_DIR=target ./scripts/package --stage "$pkgdir" \
    --libexecdir /usr/lib/flamewm --pam packaging/arch/flamewm-lock.pam
  install -Dm0644 -t "$pkgdir/usr/share/licenses/$pkgname" LICENSES/*
}
