pkgbase = flamewm-git
	pkgdesc = Rust desktop session and window manager for X11, with a Wayland compositor
	pkgver = 0.1.3
	pkgrel = 1
	url = https://github.com/ArkFlame/FlameWM
	arch = x86_64
	license = LGPL-2.0-only
	license = MIT
	license = LGPL-3.0-or-later
	license = GPL-3.0-only
	makedepends = cargo
	makedepends = git
	makedepends = pkgconf
	depends = bash
	depends = dbus
	depends = fontconfig
	depends = glibc
	depends = libdrm
	depends = libgcc
	depends = libglvnd
	depends = libinput
	depends = libpulse
	depends = libx11
	depends = libxft
	depends = libxi
	depends = libxkbcommon
	depends = mesa
	depends = pam
	depends = pambase
	depends = python
	depends = systemd-libs
	depends = xorg-xwayland
	optdepends = libxcursor: cursor theme loading
	optdepends = libxext: XShape window masks (rectangle fallback without it)
	optdepends = libxrender: core render extension (fallback without it)
	optdepends = libxcomposite: live backdrop for glass blur
	optdepends = libxdamage: live backdrop damage tracking
	optdepends = wayland: nested Wayland host backend
	optdepends = systemd: systemd-logind seat access for the Wayland DRM session
	optdepends = xdg-utils: open files and links with their default applications
	optdepends = libnotify: Explorer notifications
	optdepends = dunst: notification daemon for the session
	optdepends = xdg-desktop-portal: desktop portals (OpenURI, FileChooser)
	optdepends = xdg-desktop-portal-gtk: fallback portal backend
	optdepends = xorg-xrandr: display layout settings and restore at login
	optdepends = xorg-xprop: deferred XDG autostart after the window manager is ready
	optdepends = dex: XDG autostart entries
	optdepends = ffmpeg: screen recording
	optdepends = imagemagick: desktop Convert wheel
	optdepends = ark: archive extraction from Explorer
	optdepends = zip: archive creation from Explorer
	optdepends = udisks2: mount removable drives from Explorer
	optdepends = curl: weather data fetch in the desktop shell
	optdepends = polkit-gnome: authentication agent for privileged actions
	optdepends = polkit-kde-agent: authentication agent for privileged actions
	optdepends = xdg-desktop-portal-kde: preferred OpenURI and FileChooser portal backend
	optdepends = libxkbcommon-x11: nested --backend=nested compositor inside an X11 session
	optdepends = ttf-ibm-plex: default interface font (falls back to Noto Sans or DejaVu Sans)
	provides = flamewm=0.1.3
	conflicts = flamewm
	conflicts = mcmojave-cursors
	conflicts = mcmojave-cursors-git
	backup = etc/pam.d/flamewm-lock
	backup = etc/xdg/menus/flamewm-applications.menu
	source = flamewm::git+https://github.com/ArkFlame/FlameWM.git
	sha256sums = SKIP

pkgname = flamewm-git
