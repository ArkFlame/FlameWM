[Desktop Entry]
Type=Application
Name=FlameWM Finder
GenericName=File Search
Comment=Find files by name in FlameWM
Exec=flamewm-finder
TryExec=flamewm-finder
Icon=flamewm-finder
Terminal=false
StartupNotify=true
