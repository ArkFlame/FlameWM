FROM docker.io/library/archlinux:base-devel AS build
RUN pacman -Syu --noconfirm --needed \
      rust git pkgconf python \
      dbus fontconfig libglvnd libinput libpulse libx11 libxcomposite libxcursor \
      libxext libxft libxi libxkbcommon libxrender mesa pam systemd-libs xorg-xwayland \
    && pacman -Scc --noconfirm
WORKDIR /src
COPY . .
ENV CARGO_TARGET_DIR=/src/.target \
    CARGO_PROFILE_RELEASE_STRIP=symbols
RUN cargo build --locked --release --workspace --features flamewm-wm-wayland/drm
RUN ./scripts/package --stage /payload \
    && python3 -I tools/cpak_package.py prune /payload

FROM docker.io/library/archlinux:base
RUN pacman -Syu --noconfirm --needed \
      bash coreutils dbus fontconfig ttf-dejavu libglvnd libpulse libx11 libxcomposite \
      libxcursor libxext libxft libxi libxkbcommon libxrender python \
    && pacman -Scc --noconfirm
COPY --from=build /payload/ /
LABEL org.opencontainers.image.title="FlameWM Terminal" \
      org.opencontainers.image.source="https://github.com/ArkFlame/FlameWM" \
      org.opencontainers.image.licenses="LGPL-2.0-only AND MIT AND LGPL-3.0-or-later AND GPL-3.0-only"
ENTRYPOINT ["/usr/bin/flamewm-terminal"]
