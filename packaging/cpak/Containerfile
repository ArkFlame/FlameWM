# Isolated FlameWM Terminal / Flamefetch cpak application image, NOT a host desktop login session.
# Build release binaries on a compatible Ubuntu host; this is an image assembler, not a Rust builder.
FROM ubuntu:26.04
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
      bash ca-certificates fontconfig fonts-dejavu-core \
      libx11-6 libxext6 libxi6 libxft2 libfontconfig1 libdbus-1-3 \
      libpulse0 libpam0g python3 libgbm1 libdrm2 libinput10 libudev1 \
      libegl1 libgles2 \
    && rm -rf /var/lib/apt/lists/*
COPY payload/ /
ENTRYPOINT ["/usr/bin/flamewm-terminal"]
