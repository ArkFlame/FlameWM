#!/usr/bin/env bash
# Light pre-push gate: fmt and architecture guard only. Full CI mirror (check + clippy -D warnings): scripts/lint.
# Enable once: git config core.hooksPath .githooks
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"
cargo fmt --all -- --check
python3 -I tools/architecture_guard.py >/dev/null
