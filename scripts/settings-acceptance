#!/usr/bin/env bash
# Wrapper for the isolated System Settings native acceptance runner.
# Usage: scripts/settings-acceptance --run-dir DIR [runner options]
# Runs tools/flamewm_settings_acceptance.py and prints the result.json path.
set -euo pipefail

usage() {
  cat <<'EOF'
Usage: scripts/settings-acceptance --run-dir DIR [--geometry WxH] [--display :N]
       [--wm-bin PATH] [--settings-bin PATH] [--settle-seconds S]
       [--hotkey-click X,Y] [--hotkey-key KEYSYM]
       [--ss12-click X,Y] [--ss12-chord MOD+...+KEY]
       [--ss14-accent-pixel X,Y]
       [--ss10-scale-click X,Y] [--ss10-wheel-steps N] [--ss10-scrolled-click X,Y]

SS10 needs --ss10-wheel-steps N and --ss10-scrolled-click X,Y when the first
authoritative output lists modes. When neither is given, this wrapper passes the
measured 960x640 defaults `--ss10-wheel-steps 10 --ss10-scrolled-click 751,573`
(wheel 3 is non-deterministic; see tools/flamewm_settings_fixtures.md).

Runs the isolated native System Settings acceptance matrix in a private
Xephyr, private D-Bus session and private XDG directories under DIR.
DIR must not exist or must be empty. Writes DIR/result.json.
EOF
}

if [[ "$#" -eq 1 && ( "$1" == "--help" || "$1" == "-h" ) ]]; then
  usage
  exit 0
fi
if [[ "$#" -eq 0 ]]; then
  usage >&2
  exit 2
fi

ROOT="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd -P)"
if [[ ! -f "$ROOT/Cargo.toml" ]]; then
  echo "error: $ROOT does not contain Cargo.toml; refusing to run" >&2
  exit 2
fi

RUNNER="$ROOT/tools/flamewm_settings_acceptance.py"
if [[ ! -f "$RUNNER" ]]; then
  echo "error: runner missing: $RUNNER" >&2
  exit 2
fi

# Measured SS10 defaults (960x640 client, see tools/flamewm_settings_fixtures.md). Applied only when the
# caller gives neither SS10 scroll option; an explicit caller choice always wins.
has_ss10_scroll=0
for arg in "$@"; do
  case "$arg" in
    --ss10-wheel-steps|--ss10-wheel-steps=*|--ss10-scrolled-click|--ss10-scrolled-click=*) has_ss10_scroll=1 ;;
  esac
done
if [[ "$has_ss10_scroll" -eq 0 ]]; then
  set -- "$@" --ss10-wheel-steps 10 --ss10-scrolled-click 751,573
fi
rc=0
output="$(python3 "$RUNNER" "$@")" || rc=$?
printf '%s\n' "$output"
result_path="$(printf '%s\n' "$output" | tail -n 1)"
echo "result.json: $result_path"
exit "$rc"
