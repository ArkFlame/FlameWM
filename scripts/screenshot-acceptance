#!/usr/bin/env python3
"""Isolated Xvfb/D-Bus acceptance and bounded performance evidence for G3."""

import argparse
import ctypes as C
import ctypes.util
import json
import select
import os
from pathlib import Path
import shutil
import statistics
import struct
import subprocess
import time


X11 = C.CDLL(ctypes.util.find_library("X11"))
XTST = C.CDLL(ctypes.util.find_library("Xtst"))
Display = C.c_void_p
Window = C.c_ulong
Atom = C.c_ulong

X11.XOpenDisplay.argtypes = [C.c_char_p]
X11.XOpenDisplay.restype = Display
X11.XCloseDisplay.argtypes = [Display]
X11.XDefaultRootWindow.argtypes = [Display]
X11.XDefaultRootWindow.restype = Window
X11.XCreateSimpleWindow.argtypes = [
    Display, Window, C.c_int, C.c_int, C.c_uint, C.c_uint, C.c_uint, C.c_ulong, C.c_ulong
]
X11.XCreateSimpleWindow.restype = Window
X11.XMapWindow.argtypes = [Display, Window]
X11.XDestroyWindow.argtypes = [Display, Window]
X11.XSync.argtypes = [Display, C.c_int]
X11.XFlush.argtypes = [Display]
X11.XWarpPointer.argtypes = [Display, Window, Window, C.c_int, C.c_int, C.c_uint, C.c_uint, C.c_int, C.c_int]
X11.XInternAtom.argtypes = [Display, C.c_char_p, C.c_int]
X11.XInternAtom.restype = Atom
X11.XConvertSelection.argtypes = [Display, Atom, Atom, Atom, Window, C.c_ulong]
X11.XPending.argtypes = [Display]
X11.XGetWindowProperty.argtypes = [
    Display, Window, Atom, C.c_long, C.c_long, C.c_int, Atom,
    C.POINTER(Atom), C.POINTER(C.c_int), C.POINTER(C.c_ulong),
    C.POINTER(C.c_ulong), C.POINTER(C.POINTER(C.c_ubyte)),
]
X11.XFree.argtypes = [C.c_void_p]
XTST.XTestFakeMotionEvent.argtypes = [Display, C.c_int, C.c_int, C.c_int, C.c_ulong]
XTST.XTestFakeButtonEvent.argtypes = [Display, C.c_uint, C.c_int, C.c_ulong]
XTST.XTestFakeKeyEvent.argtypes = [Display, C.c_uint, C.c_int, C.c_ulong]
X11.XKeysymToKeycode.argtypes = [Display, C.c_ulong]
X11.XKeysymToKeycode.restype = C.c_uint
XK_ESCAPE = 0xFF1B


class XSelectionEvent(C.Structure):
    _fields_ = [
        ("type", C.c_int), ("serial", C.c_ulong), ("send_event", C.c_int),
        ("display", Display), ("requestor", Window), ("selection", Atom),
        ("target", Atom), ("property", Atom), ("time", C.c_ulong),
    ]


class XEvent(C.Union):
    _fields_ = [("type", C.c_int), ("selection", XSelectionEvent), ("pad", C.c_long * 24)]


X11.XNextEvent.argtypes = [Display, C.POINTER(XEvent)]


def wait_for_stderr_line(process, marker, timeout):
    """Block until the child prints `marker` on stderr; this is a readiness signal, not a delay."""
    deadline = time.monotonic() + timeout
    seen = []
    while True:
        if process.poll() is not None:
            raise AssertionError(f"process exited before {marker!r}: {process.poll()} {''.join(seen)}")
        if time.monotonic() >= deadline:
            raise AssertionError(f"timed out waiting for {marker!r}: {''.join(seen)}")
        if select.select([process.stderr], [], [], 0.05)[0]:
            line = process.stderr.readline()
            seen.append(line)
            if marker in line:
                return seen


def indicator_ids(log_path):
    if not log_path.exists():
        return []
    entries = [json.loads(line) for line in log_path.read_text().splitlines()]
    return [e["id"] for e in entries if e.get("summary") == "Recording screen"]


def wait_for_indicator(log_path, timeout, after_id):
    """Returns the first recording indicator posted after `after_id` (earlier ones belong to other runs)."""
    deadline = time.monotonic() + timeout
    while time.monotonic() < deadline:
        newer = [i for i in indicator_ids(log_path) if i > after_id]
        if newer:
            return newer[0]
        time.sleep(0.05)
    raise AssertionError("recording indicator notification was not delivered")


def open_display(name):
    display = X11.XOpenDisplay(name.encode())
    if not display:
        raise RuntimeError(f"cannot open owned display {name}")
    return display


def png_rgba(path):
    """Decode an 8-bit RGBA, non-interlaced PNG into (width, height, rows of bytearray)."""
    import zlib
    data = path.read_bytes()
    if data[:8] != b"\x89PNG\r\n\x1a\n":
        raise AssertionError(f"not a PNG: {path}")
    pos, idat, width, height = 8, b"", 0, 0
    while pos < len(data):
        length, kind = struct.unpack(">I4s", data[pos:pos + 8])
        body = data[pos + 8:pos + 8 + length]
        if kind == b"IHDR":
            width, height, depth, color, _, _, interlace = struct.unpack(">IIBBBBB", body[:13])
            if (depth, color, interlace) != (8, 6, 0):
                raise AssertionError(f"unsupported PNG format depth={depth} color={color} interlace={interlace}")
        elif kind == b"IDAT":
            idat += body
        pos += 12 + length
    raw = zlib.decompress(idat)
    stride = width * 4
    rows, previous = [], bytearray(stride)
    for y in range(height):
        kind_byte, line = raw[y * (stride + 1)], bytearray(raw[y * (stride + 1) + 1:(y + 1) * (stride + 1)])
        for i in range(stride):
            left = line[i - 4] if i >= 4 else 0
            up = previous[i]
            upleft = previous[i - 4] if i >= 4 else 0
            if kind_byte == 1:
                line[i] = (line[i] + left) & 0xFF
            elif kind_byte == 2:
                line[i] = (line[i] + up) & 0xFF
            elif kind_byte == 3:
                line[i] = (line[i] + (left + up) // 2) & 0xFF
            elif kind_byte == 4:
                p = left + up - upleft
                pa, pb, pc = abs(p - left), abs(p - up), abs(p - upleft)
                pred = left if pa <= pb and pa <= pc else (up if pb <= pc else upleft)
                line[i] = (line[i] + pred) & 0xFF
            elif kind_byte != 0:
                raise AssertionError(f"unknown PNG filter {kind_byte}")
        rows.append(line)
        previous = line
    return width, height, rows


def rgb_at(rows, x, y):
    row = rows[y]
    return tuple(row[x * 4:x * 4 + 3])


def png_size(path):
    data = path.read_bytes()[:33]
    if len(data) != 33 or data[:8] != b"\x89PNG\r\n\x1a\n" or data[12:16] != b"IHDR":
        raise AssertionError(f"invalid PNG header: {path}")
    return struct.unpack(">II", data[16:24])


def clipboard_png(display_name):
    display = open_display(display_name)
    try:
        root = X11.XDefaultRootWindow(display)
        requestor = X11.XCreateSimpleWindow(display, root, 0, 0, 1, 1, 0, 0, 0)
        clipboard = X11.XInternAtom(display, b"CLIPBOARD", 0)
        png = X11.XInternAtom(display, b"image/png", 0)
        prop = X11.XInternAtom(display, b"FLAMEWM_G3_ACCEPTANCE", 0)
        X11.XConvertSelection(display, clipboard, png, prop, requestor, 0)
        X11.XFlush(display)
        deadline = time.monotonic() + 3
        event = XEvent()
        while time.monotonic() < deadline:
            while X11.XPending(display):
                X11.XNextEvent(display, C.byref(event))
                if event.type == 31 and event.selection.requestor == requestor:
                    if event.selection.property == 0:
                        raise AssertionError("clipboard refused image/png")
                    actual, fmt = Atom(), C.c_int()
                    count, remaining = C.c_ulong(), C.c_ulong()
                    value = C.POINTER(C.c_ubyte)()
                    status = X11.XGetWindowProperty(
                        display, requestor, prop, 0, 1 << 20, 1, 0,
                        C.byref(actual), C.byref(fmt), C.byref(count), C.byref(remaining), C.byref(value),
                    )
                    if status != 0 or fmt.value != 8:
                        raise AssertionError(f"clipboard property failed: status={status} format={fmt.value}")
                    if actual.value != png:
                        X11.XFree(value)
                        raise AssertionError("clipboard requires unexpected INCR for small region")
                    payload = C.string_at(value, count.value)
                    X11.XFree(value)
                    return payload
            time.sleep(0.01)
        raise AssertionError("timed out waiting for clipboard SelectionNotify")
    finally:
        X11.XCloseDisplay(display)


def terminate(process):
    if process is not None and process.poll() is None:
        process.terminate()
        try:
            process.wait(timeout=3)
        except subprocess.TimeoutExpired:
            process.kill()
            process.wait(timeout=3)


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument("--binary", type=Path, required=True)
    parser.add_argument("--evidence", type=Path, required=True)
    args = parser.parse_args()
    binary = args.binary.resolve(strict=True)
    evidence = args.evidence.resolve()
    evidence.mkdir(parents=True, exist_ok=False)
    home = evidence / "home"
    home.mkdir()
    (evidence / "cwd").mkdir()
    command_log = (evidence / "commands.jsonl").open("a", encoding="utf-8")
    xvfb_log = (evidence / "xvfb.log").open("w", encoding="utf-8")
    notification_log_path = evidence / "notifications.jsonl"
    notification_stderr = (evidence / "notification-service.log").open("w", encoding="utf-8")
    result = {"status": "FAIL", "width": 2560, "height": 1440, "samples": 5}
    xvfb = dbus = service = None
    env = os.environ.copy()
    env.pop("DISPLAY", None)
    env.pop("WAYLAND_DISPLAY", None)
    env.update({"HOME": str(home), "XDG_CONFIG_HOME": str(home / ".config")})

    def run(command, timeout=10, attempts=3):
        # Known intermittent: the isolated server occasionally resets a fresh client connection
        # (os error 104) right after another client finished. Root cause unproven; each failed
        # attempt is logged in commands.jsonl, and only that connect error is retried.
        for attempt in range(1, attempts + 1):
            start = time.monotonic()
            completed = subprocess.run(
                [str(part) for part in command], env=env, cwd=evidence / "cwd",
                stdin=subprocess.DEVNULL, capture_output=True, text=True, timeout=timeout,
            )
            row = {
                "command": [str(part) for part in command], "exit": completed.returncode,
                "attempt": attempt, "elapsed_s": time.monotonic() - start,
                "stdout": completed.stdout, "stderr": completed.stderr,
            }
            command_log.write(json.dumps(row) + "\n")
            command_log.flush()
            if completed.returncode == 0:
                return completed
            if "X11 connection failed" not in completed.stderr or attempt == attempts:
                raise AssertionError(f"command failed: {row}")
            time.sleep(0.2)
        raise AssertionError("unreachable")

    try:
        display_name = None
        for number in range(140, 180):
            if Path(f"/tmp/.X11-unix/X{number}").exists() or Path(f"/tmp/.X{number}-lock").exists():
                continue
            candidate = f":{number}"
            process = subprocess.Popen(
                ["Xvfb", candidate, "-screen", "0", "2560x1440x24", "-nolisten", "tcp"],
                env=env, stdin=subprocess.DEVNULL, stdout=xvfb_log, stderr=xvfb_log,
            )
            deadline = time.monotonic() + 3
            while time.monotonic() < deadline and process.poll() is None:
                try:
                    probe = open_display(candidate)
                except RuntimeError:
                    time.sleep(0.02)
                else:
                    X11.XCloseDisplay(probe)
                    display_name, xvfb = candidate, process
                    break
            if display_name:
                break
            terminate(process)
        if not display_name:
            raise RuntimeError("could not start an isolated Xvfb")
        env["DISPLAY"] = display_name
        result["display"] = display_name

        dbus = subprocess.Popen(
            ["dbus-daemon", "--session", "--nofork", "--print-address=1", "--print-pid=1"],
            env=env, stdin=subprocess.DEVNULL, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True,
        )
        address = dbus.stdout.readline().strip()
        daemon_pid = int(dbus.stdout.readline().strip())
        if not address or daemon_pid != dbus.pid:
            raise RuntimeError("private D-Bus daemon did not report its owned identity")
        env["DBUS_SESSION_BUS_ADDRESS"] = address
        service = subprocess.Popen(
            ["/usr/bin/python3", str(Path(__file__).resolve().parent / "tests/screenshot/notification-service.py"), str(notification_log_path)],
            env=env, stdin=subprocess.DEVNULL, stdout=subprocess.PIPE, stderr=notification_stderr, text=True,
        )
        if service.stdout.readline().strip() != "ready":
            raise RuntimeError("private notification service did not start")

        full = run([binary, "--full", "--name-template", "acceptance-{mode}-{width}x{height}-{timestamp}-{nanos}"])
        full_path = Path(full.stdout.strip())
        expected_dir = home / "Pictures" / "Screenshots"
        if full_path.parent != expected_dir or not full_path.name.startswith("acceptance-full-2560x1440-"):
            raise AssertionError(f"template/default directory mismatch: {full_path}")
        if png_size(full_path) != (2560, 1440):
            raise AssertionError("full-screen dimensions mismatch")
        result["full"] = str(full_path)

        delay_path = evidence / "delayed.png"
        delay_start = time.monotonic()
        run([binary, "--full", "--delay", "0.15", "--output", delay_path])
        delay_elapsed = time.monotonic() - delay_start
        if delay_elapsed < 0.13 or png_size(delay_path) != (2560, 1440):
            raise AssertionError("delay timer did not elapse before capture")
        result["delay_s"] = delay_elapsed

        fixture_display = open_display(display_name)
        display = fixture_display
        root = X11.XDefaultRootWindow(display)
        fixture = X11.XCreateSimpleWindow(display, root, 40, 60, 320, 200, 0, 0, 0x00FF0000)
        X11.XMapWindow(display, fixture)
        # Left 160 px red, right 160 px blue: the region crop must reproduce this boundary exactly.
        gc = X11.XCreateGC(display, fixture, 0, None)
        X11.XSetForeground(display, gc, 0x000000FF)
        X11.XFillRectangle(display, fixture, gc, 160, 0, 160, 200)
        X11.XWarpPointer(display, 0, fixture, 0, 0, 0, 0, 100, 80)
        X11.XSync(display, 0)
        window_path = evidence / "window.png"
        run([binary, "--window", "--output", window_path])
        if png_size(window_path) != (320, 200):
            raise AssertionError(f"window capture dimensions mismatch: {png_size(window_path)}")
        result["window"] = str(window_path)

        region_path = evidence / "region.png"
        region = subprocess.Popen(
            [str(binary), "--region", "--copy", "--output", str(region_path)],
            env=env, cwd=evidence / "cwd", stdin=subprocess.DEVNULL,
            stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True,
        )
        ready_lines = wait_for_stderr_line(region, "region overlay ready", 10)
        driver = open_display(display_name)
        # Paced steps: each request is synced so the grab sees press, motion and release in order.
        for step in (
            lambda: XTST.XTestFakeMotionEvent(driver, -1, 100, 100, 0),
            lambda: XTST.XTestFakeButtonEvent(driver, 1, 1, 0),
            lambda: XTST.XTestFakeMotionEvent(driver, -1, 219, 179, 0),
            lambda: XTST.XTestFakeButtonEvent(driver, 1, 0, 0),
        ):
            step()
            X11.XSync(driver, 0)
            time.sleep(0.1)
        X11.XCloseDisplay(driver)
        stdout, stderr = region.communicate(timeout=5)
        stderr = "".join(ready_lines) + stderr
        command_log.write(json.dumps({"command": ["region+drag+copy"], "exit": region.returncode, "stdout": stdout, "stderr": stderr}) + "\n")
        if region.returncode != 0 or png_size(region_path) != (120, 80):
            raise AssertionError(f"interactive region failed: exit={region.returncode} size={png_size(region_path)} stderr={stderr}")
        # Region is root (100,100)-(219,179); fixture is red for root x<200 and blue from x=200.
        _, _, rows = png_rgba(region_path)
        red, blue = (255, 0, 0), (0, 0, 255)
        mismatches = []
        for y in range(80):
            for x in range(120):
                expected = red if 100 + x < 200 else blue
                if rgb_at(rows, x, y) != expected:
                    mismatches.append((x, y, rgb_at(rows, x, y)))
        if mismatches:
            raise AssertionError(f"region pixels differ from fixture: {len(mismatches)} e.g. {mismatches[:3]}")
        result["region_pixels"] = {"red_columns": 100, "blue_columns": 20, "checked": 120 * 80}
        X11.XDestroyWindow(fixture_display, fixture)
        X11.XCloseDisplay(fixture_display)
        # Esc cancel: the overlay is ready, Escape is injected with XTest, and nothing is saved.
        cancel_path = evidence / "cancelled.png"
        cancel = subprocess.Popen(
            [str(binary), "--region", "--output", str(cancel_path)],
            env=env, cwd=evidence / "cwd", stdin=subprocess.DEVNULL,
            stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True,
        )
        wait_for_stderr_line(cancel, "region overlay ready", 10)
        driver = open_display(display_name)
        XTST.XTestFakeMotionEvent(driver, -1, 50, 50, 0)
        X11.XSync(driver, 0)
        keycode = X11.XKeysymToKeycode(driver, XK_ESCAPE)
        XTST.XTestFakeKeyEvent(driver, keycode, 1, 0)
        X11.XSync(driver, 0)
        XTST.XTestFakeKeyEvent(driver, keycode, 0, 0)
        X11.XSync(driver, 0)
        X11.XCloseDisplay(driver)
        cancel_stdout, cancel_stderr = cancel.communicate(timeout=10)
        if cancel.returncode != 0 or cancel_path.exists() or "screenshot cancelled" not in cancel_stderr:
            raise AssertionError(f"Esc cancel failed: exit={cancel.returncode} exists={cancel_path.exists()} stderr={cancel_stderr}")
        result["esc_cancel"] = {"exit": cancel.returncode, "file_written": False, "message": "screenshot cancelled"}

        # Recording: real encode when ffmpeg is installed; otherwise the binary must refuse clearly.
        if shutil.which("ffmpeg") and shutil.which("ffprobe"):
            recording = evidence / "recording.mp4"
            run([binary, "--full", "--record", "2", "--fps", "30", "--output", recording], timeout=60)
            probe = subprocess.run(
                ["ffprobe", "-v", "error", "-select_streams", "v:0", "-show_entries",
                 "stream=codec_name,width,height", "-of", "csv=p=0", str(recording)],
                env=env, capture_output=True, text=True, timeout=30,
            )
            if probe.stdout.strip() != "h264,2560,1440":
                raise AssertionError(f"recording stream mismatch: {probe.stdout!r} {probe.stderr!r}")
            result["recording"] = {"codec": "h264", "size": [2560, 1440], "fps": 30, "seconds": 2}
            # Stop action: a long recording ends when the indicator's Stop action is invoked.
            stop_path = evidence / "stop.mp4"
            baseline = max(indicator_ids(notification_log_path), default=0)
            stopper = subprocess.Popen(
                [str(binary), "--full", "--record", "60", "--fps", "10", "--output", str(stop_path)],
                env=env, cwd=evidence / "cwd", stdin=subprocess.DEVNULL,
                stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True,
            )
            started = time.monotonic()
            indicator = wait_for_indicator(notification_log_path, 10, baseline)
            # A click can race the listener's subscription, so the click is re-sent until the
            # recording acknowledges it by exiting; a lost signal is not a stop request.
            emit_deadline = time.monotonic() + 20
            while stopper.poll() is None and time.monotonic() < emit_deadline:
                subprocess.run(
                    ["gdbus", "emit", "--session", "--object-path", "/org/freedesktop/Notifications",
                     "--signal", "org.freedesktop.Notifications.ActionInvoked", f"uint32 {indicator}", "'stop'"],
                    env=env, check=True, capture_output=True, text=True, timeout=10,
                )
                try:
                    stopper.wait(timeout=0.2)
                except subprocess.TimeoutExpired:
                    pass
            stop_stdout, stop_stderr = stopper.communicate(timeout=30)
            elapsed = time.monotonic() - started
            if stopper.returncode != 0 or not stop_path.exists() or elapsed >= 30 or "frames written" not in stop_stderr:
                raise AssertionError(f"stop action failed: exit={stopper.returncode} elapsed={elapsed:.1f} stderr={stop_stderr}")
            result["stop_action"] = {"indicator_id": indicator, "elapsed_s": round(elapsed, 2), "exit": stopper.returncode}
        else:
            result["recording"] = "skipped: ffmpeg or ffprobe not installed"
        bare_path = evidence / "no-ffmpeg-bin"
        bare_path.mkdir()
        degraded_env = dict(env, PATH=str(bare_path))
        degraded_out = evidence / "degraded.mp4"
        degraded = subprocess.run(
            [str(binary), "--full", "--record", "1", "--output", str(degraded_out)],
            env=degraded_env, cwd=evidence / "cwd", stdin=subprocess.DEVNULL,
            capture_output=True, text=True, timeout=30,
        )
        if degraded.returncode == 0 or "needs ffmpeg" not in degraded.stderr or degraded_out.exists():
            raise AssertionError(f"recording without ffmpeg did not degrade cleanly: {degraded}")
        result["recording_degraded"] = degraded.stderr.strip()

        clipboard = clipboard_png(display_name)
        if clipboard != region_path.read_bytes():
            raise AssertionError("clipboard PNG differs from saved region PNG")
        result["region"] = {"path": str(region_path), "size": [120, 80], "clipboard_bytes": len(clipboard)}

        performance = []
        for index in range(5):
            output = evidence / f"performance-{index}.png"
            timing = evidence / f"performance-{index}.time"
            run(["/usr/bin/time", "-f", "elapsed_s=%e\nmaxrss_kb=%M", "-o", timing,
                 binary, "--full", "--output", output])
            fields = dict(line.split("=", 1) for line in timing.read_text().splitlines())
            sample = {
                "sample": index, "size": [2560, 1440], "elapsed_s": float(fields["elapsed_s"]),
                "maxrss_kb": int(fields["maxrss_kb"]), "png_bytes": output.stat().st_size,
            }
            if png_size(output) != (2560, 1440):
                raise AssertionError("performance capture dimensions mismatch")
            performance.append(sample)
            (evidence / "performance.jsonl").open("a").write(json.dumps(sample) + "\n")
        result["performance"] = performance
        result["summary"] = {
            "latency_min_s": min(s["elapsed_s"] for s in performance),
            "latency_median_s": statistics.median(s["elapsed_s"] for s in performance),
            "latency_max_s": max(s["elapsed_s"] for s in performance),
            "peak_rss_max_kb": max(s["maxrss_kb"] for s in performance),
            "scope": "whole process: MIT-SHM capture (GetImage fallback), RGBA conversion, PNG encode/save, notification client",
        }
        deadline = time.monotonic() + 3
        notifications = []
        while time.monotonic() < deadline:
            if notification_log_path.exists():
                notifications = [json.loads(line) for line in notification_log_path.read_text().splitlines()]
            if sum(n.get("summary") == "Screenshot captured" for n in notifications) >= 9:
                break
            time.sleep(0.02)
        # The recording indicator is a separate, expected notification from the recording step.
        notifications = [n for n in notifications if n.get("summary") != "Recording screen"]
        if len(notifications) != 9 or any(n["app"] != "FlameWM" or n["summary"] != "Screenshot captured" or not n["body"].startswith("Saved to ") for n in notifications):
            raise AssertionError(f"unexpected notification deliveries: {notifications}")
        result["notify_method_calls"] = len(notifications)
        result["status"] = "PASS"
    except Exception as error:
        result["error"] = f"{type(error).__name__}: {error}"
        raise
    finally:
        result["owned_process_cleanup"] = {}
        for name, process in (("notification-service", service), ("dbus-daemon", dbus), ("Xvfb", xvfb)):
            terminate(process)
            result["owned_process_cleanup"][name] = None if process is None else process.returncode
        (evidence / "result.json").write_text(json.dumps(result, indent=2) + "\n")
        command_log.close()
        notification_stderr.close()
        xvfb_log.close()
    print(json.dumps(result, indent=2))


if __name__ == "__main__":
    main()
