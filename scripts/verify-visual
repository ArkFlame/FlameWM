#!/usr/bin/env bash
set -euo pipefail
SCRIPT_PATH="$(readlink -f "${BASH_SOURCE[0]}")"
ROOT="$(cd "$(dirname "$SCRIPT_PATH")/.." && pwd -P)"
cd "$ROOT"

usage() {
  cat <<'EOF'
Usage: scripts/verify-visual [--product | --reference]

  --product    Run scripts/xephyr and capture its fresh root screenshot (default).
               This validates only the root session image, not Settings,
               popups, or other interactive states.
  --reference  Compare explicitly supplied existing images; does not launch a session.
  -h, --help   Show this help.

Environment:
  FLAMEWM_VISUAL_REFERENCE    Reference image path (required for --reference)
  FLAMEWM_VISUAL_CURRENT      Current image path (required for --reference)
  FLAMEWM_VISUAL_RMSE_MAX     Optional maximum RMSE; only gates when both thresholds are set
  FLAMEWM_VISUAL_AE_MAX       Optional maximum absolute error; only gates with RMSE_MAX
  FLAMEWM_XEPHYR_DISPLAY      Optional nested display; scripts/xephyr chooses a free one otherwise
  Product mode runs the T06/T07 hard-native and SR canary lane.
EOF
}

MODE=product
while (($#)); do
  case "$1" in
    --product) MODE=product ;;
    --reference) MODE=reference ;;
    -h|--help) usage; exit 0 ;;
    *) echo "Unknown option: $1" >&2; usage >&2; exit 2 ;;
  esac
  shift
done

have_imagemagick=0
if command -v magick >/dev/null 2>&1; then
  IM_MODE=magick7
  have_imagemagick=1
elif command -v identify >/dev/null 2>&1 && command -v compare >/dev/null 2>&1; then
  IM_MODE=legacy
  have_imagemagick=1
fi

im_identify() {
  if [[ "$IM_MODE" == magick7 ]]; then magick identify "$@"; else identify "$@"; fi
}
im_compare() {
  if [[ "$IM_MODE" == magick7 ]]; then magick compare "$@"; else compare "$@"; fi
}

if [[ "$MODE" == reference ]]; then
  current="${FLAMEWM_VISUAL_CURRENT:-}"
  reference="${FLAMEWM_VISUAL_REFERENCE:-}"
  [[ -n "$current" ]] || { echo 'ENV_BLOCKED: set FLAMEWM_VISUAL_CURRENT to inventory the current image path' >&2; exit 3; }
  [[ -n "$reference" ]] || { echo 'ENV_BLOCKED: set FLAMEWM_VISUAL_REFERENCE to inventory the reference image path' >&2; exit 3; }
  printf 'VISUAL_CURRENT %s\nVISUAL_REFERENCE %s\n' "$current" "$reference"
  [[ -s "$current" ]] || { echo "VISUAL_FAIL: current image missing or empty: $current" >&2; exit 3; }
  [[ -s "$reference" ]] || { echo "VISUAL_FAIL: reference image missing or empty: $reference" >&2; exit 3; }
  [[ "$have_imagemagick" == 1 ]] || { echo 'ENV_BLOCKED: ImageMagick identify+compare is required for reference mode' >&2; exit 3; }
  if ! current_geom="$(im_identify -format '%wx%h' "$current" 2>&1)"; then
    echo "VISUAL_FAIL ImageMagick could not parse current image $current: $current_geom" >&2; exit 1
  fi
  if ! reference_geom="$(im_identify -format '%wx%h' "$reference" 2>&1)"; then
    echo "VISUAL_FAIL ImageMagick could not parse reference image $reference: $reference_geom" >&2; exit 1
  fi
  [[ "$current_geom" == "$reference_geom" ]] || { echo "VISUAL_FAIL geometry current=$current_geom reference=$reference_geom" >&2; exit 1; }

  rmse_output="$(im_compare -metric RMSE "$reference" "$current" null: 2>&1)" || {
    rc=$?; echo "VISUAL_FAIL ImageMagick RMSE comparison failed (exit $rc): $rmse_output" >&2; exit 1;
  }
  ae_output="$(im_compare -metric AE "$reference" "$current" null: 2>&1)" || {
    rc=$?; echo "VISUAL_FAIL ImageMagick AE comparison failed (exit $rc): $ae_output" >&2; exit 1;
  }
  printf 'VISUAL_RMSE %s\nVISUAL_AE %s\n' "$rmse_output" "$ae_output"
  case "$reference" in
    *0.0.6*|*0.0.7*) echo "ORACLE_STALE advisory: reference path is from a stale product version: $reference" ;;
    *) echo 'ORACLE_UNAPPROVED advisory: no approved oracle status is established by this tool' ;;
  esac

  if [[ -n "${FLAMEWM_VISUAL_RMSE_MAX:-}" && -n "${FLAMEWM_VISUAL_AE_MAX:-}" ]]; then
    rmse_value="${rmse_output%% *}"
    ae_value="${ae_output%% *}"
    awk -v actual="$rmse_value" -v max="${FLAMEWM_VISUAL_RMSE_MAX}" 'BEGIN { exit !(actual+0 <= max+0) }' || { echo 'VISUAL_FAIL RMSE threshold exceeded' >&2; exit 1; }
    awk -v actual="$ae_value" -v max="${FLAMEWM_VISUAL_AE_MAX}" 'BEGIN { exit !(actual+0 <= max+0) }' || { echo 'VISUAL_FAIL AE threshold exceeded' >&2; exit 1; }
    echo 'VISUAL_REFERENCE_COMPARE_PASS (explicit RMSE and AE thresholds satisfied; oracle approval not implied)'
  else
    echo 'VISUAL_REFERENCE_COMPARE_ADVISORY (metrics are not gates without both explicit thresholds)'
  fi
  exit 0
fi

for tool in dbus-run-session Xephyr; do
  command -v "$tool" >/dev/null 2>&1 || { echo "ENV_BLOCKED: required executable missing: $tool" >&2; exit 3; }
done
[[ -n "${DISPLAY:-}" ]] || { echo 'ENV_BLOCKED: DISPLAY is required by scripts/xephyr' >&2; exit 3; }
[[ -x scripts/xephyr ]] || { echo 'ENV_BLOCKED: scripts/xephyr is missing or not executable' >&2; exit 3; }

VISUAL_ROOT=.target/flamewm/visual
mkdir -p "$VISUAL_ROOT"
run_id="$(date -u +%Y%m%dT%H%M%SZ)-$$-${RANDOM}"
run_dir="$VISUAL_ROOT/$run_id"
mkdir "$run_dir"
runner_shot=.target/flamewm/canary-root.png
runner_xwd=.target/flamewm/canary-root.xwd
for generated in "$runner_shot" "$runner_xwd"; do
  if [[ -e "$generated" || -L "$generated" ]]; then
    if ! mv -- "$generated" "$run_dir/$(basename "$generated").preexisting"; then
      echo "VISUAL_FAIL could not preserve pre-existing generated screenshot: $generated" >&2
      exit 1
    fi
  fi
done

# The runner only writes canary-root.png in bounded canary mode. That mode
# retains its WM/desktop/shell supervision and provides the runner-owned capture.
if FLAMEWM_XEPHYR_CANARY=1 FLAMEWM_XEPHYR_HARD_T06=1 FLAMEWM_XEPHYR_CANARY_SECS=1 FLAMEWM_XEPHYR_PRIVATE_DBUS=1 ./scripts/xephyr >"$run_dir/xephyr-runner.log" 2>&1; then
  :
else
  rc=$?
  echo "VISUAL_FAIL scripts/xephyr exited $rc; see $run_dir/xephyr-runner.log" >&2
  exit 1
fi

if [[ -s "$runner_shot" ]]; then
  shot="$run_dir/root.png"
  if ! mv -- "$runner_shot" "$shot"; then
    echo "VISUAL_FAIL could not preserve this invocation's root screenshot: $runner_shot" >&2; exit 1
  fi
elif [[ -s "$runner_xwd" ]]; then
  shot="$run_dir/root.xwd"
  if ! mv -- "$runner_xwd" "$shot"; then
    echo "VISUAL_FAIL could not preserve this invocation's root screenshot: $runner_xwd" >&2; exit 1
  fi
else
  echo "VISUAL_FAIL scripts/xephyr did not create a new non-empty root screenshot; runner evidence: $run_dir/xephyr-runner.log" >&2
  exit 1
fi
size="$(wc -c <"$shot" | tr -d '[:space:]')"
[[ "$size" -gt 0 ]] || { echo 'VISUAL_FAIL root screenshot is empty' >&2; exit 1; }
if [[ "$have_imagemagick" == 1 ]]; then
  if ! geometry="$(im_identify -format '%wx%h' "$shot" 2>&1)"; then
    echo "VISUAL_FAIL ImageMagick could not parse root screenshot $shot: $geometry" >&2; exit 1
  fi
  if [[ "$shot" == *.png ]]; then
    if ! mean="$(im_identify -format '%[mean]' "$shot" 2>&1)"; then
      echo "VISUAL_FAIL ImageMagick could not inspect root screenshot $shot: $mean" >&2; exit 1
    fi
    [[ "$mean" != 0 ]] || { echo 'VISUAL_FAIL root screenshot is all black' >&2; exit 1; }
    echo "VISUAL_ROOT_IMAGE $shot bytes=$size geometry=$geometry mean=$mean"
  else
    echo "VISUAL_ROOT_IMAGE $shot bytes=$size geometry=$geometry (XWD retained; no parity comparison performed)"
  fi
else
  echo "VISUAL_ROOT_IMAGE $shot bytes=$size (ImageMagick unavailable; parse/geometry/nonblack checks unavailable)"
fi
echo 'PASS ROOT_SCREENSHOT + HARD_NATIVE_T06_T07 (scripts/xephyr product canary lane)'
echo 'NOT_CAPTURABLE Start/Settings/popups; no reviewed oracle parity is claimed'
