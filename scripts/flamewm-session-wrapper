#!/usr/bin/env bash
# Lifecycle companion: no display/wallet policy changes, no extra session bus.
# Session startup fallback tail: x11 session -> minimal safe mode. A display-manager launch runs the
# tail through the supervisor below; FLAMEWM_SESSION_ATTEMPT=x11 re-enters the original single-attempt
# path unchanged, so the lifecycle contract (one bridge, no extra bus) stays intact.
# UNBUILT: no cargo/build/test was run in this unit; verification belongs to the orchestrator.
set -uo pipefail

CHAIN_CACHE_DIR=""
if [[ -n "${HOME:-}${XDG_CACHE_HOME:-}" ]]; then
    CHAIN_CACHE_DIR="${XDG_CACHE_HOME:-${HOME}/.cache}/flamewm"
fi
CHAIN_LOG=""
CHAIN_STATE=""
if [[ -n "$CHAIN_CACHE_DIR" ]] && mkdir -p "$CHAIN_CACHE_DIR" 2>/dev/null \
    && [[ -d "$CHAIN_CACHE_DIR" && -w "$CHAIN_CACHE_DIR" ]]; then
    if ( umask 077; : >>"$CHAIN_CACHE_DIR/session-chain.log" ) 2>/dev/null; then
        CHAIN_LOG="$CHAIN_CACHE_DIR/session-chain.log"
        chmod 600 "$CHAIN_LOG" 2>/dev/null || :
    fi
    CHAIN_STATE="$CHAIN_CACHE_DIR/session-chain.state"
fi
CHAIN_GUARD_WINDOW_S="${FLAMEWM_CHAIN_GUARD_WINDOW_S:-60}"
CHAIN_GUARD_MAX="${FLAMEWM_CHAIN_GUARD_MAX:-3}"
[[ "$CHAIN_GUARD_WINDOW_S" =~ ^[0-9]+$ ]] || CHAIN_GUARD_WINDOW_S=60
[[ "$CHAIN_GUARD_MAX" =~ ^[0-9]+$ ]] || CHAIN_GUARD_MAX=3
CHAIN_ATTEMPTS=0
CHAIN_CHILD=""

chain_now_ms() {
    local value sec frac
    if [[ -r /proc/uptime ]] && read -r value _ < /proc/uptime 2>/dev/null; then
        sec="${value%%.*}"; frac="${value#*.}000"
        printf '%s' "$(( 10#${sec:-0} * 1000 + 10#${frac:0:3} ))"
    else
        printf '%s' "$(( $(date +%s) * 1000 ))"
    fi
}
CHAIN_START_MS="$(chain_now_ms)"
chain_ms() { printf '%s' "$(( $(chain_now_ms) - CHAIN_START_MS ))"; }

chain_record() { # stage status cause code works degraded [extra]
    local line prefix
    prefix="$(date '+%F %T' 2>/dev/null)"
    line="$prefix FLAMEWM-SESSION-CHAIN stage=$1 status=$2 cause=$3 code=$4 blast_radius=works:$5|degraded:$6 ms=$(chain_ms)"
    [[ -n "${7:-}" ]] && line+=" detail=$7"
    printf '%s\n' "$line" >&2
    [[ -n "$CHAIN_LOG" ]] && printf '%s\n' "$line" >>"$CHAIN_LOG" 2>/dev/null || :
}

# The state file is shared with flamewm-wayland-session, so a display manager that bounces between
# the two session entries cannot multiply the number of attempts.
chain_guard_trip() {
    local now last
    CHAIN_ATTEMPTS=1
    [[ -n "$CHAIN_STATE" ]] || return 1
    now="$(date +%s)"
    if [[ -r "$CHAIN_STATE" ]]; then
        read -r last CHAIN_ATTEMPTS < "$CHAIN_STATE" 2>/dev/null || { last=0; CHAIN_ATTEMPTS=1; }
        [[ "$last" =~ ^[0-9]+$ ]] || last=0
        [[ "$CHAIN_ATTEMPTS" =~ ^[0-9]+$ ]] || CHAIN_ATTEMPTS=1
        if (( now - last <= CHAIN_GUARD_WINDOW_S )); then
            CHAIN_ATTEMPTS=$(( CHAIN_ATTEMPTS + 1 ))
        else
            CHAIN_ATTEMPTS=1
        fi
    fi
    ( umask 077; printf '%s %s\n' "$now" "$CHAIN_ATTEMPTS" > "$CHAIN_STATE" ) 2>/dev/null || :
    (( CHAIN_ATTEMPTS > CHAIN_GUARD_MAX ))
}
chain_clear_guard() { [[ -n "$CHAIN_STATE" ]] && rm -f "$CHAIN_STATE" 2>/dev/null || :; }

chain_forward() {
    local sig="$1"
    [[ -n "$CHAIN_CHILD" ]] && kill -s "$sig" "$CHAIN_CHILD" 2>/dev/null || :
}
chain_wait() {
    local pid="$1" rc=0
    while :; do
        wait "$pid"; rc=$?
        kill -s 0 "$pid" 2>/dev/null || break
    done
    return "$rc"
}

chain_cause() {
    local rc="$2" cause slog
    case "$rc" in
        126) cause="binary_not_executable" ;;
        127) cause="binary_missing" ;;
        129|130|143) cause="signal_logout" ;;
        1) cause="session_preflight" ;;
        *) cause="session_exit" ;;
    esac
    slog="${XDG_STATE_HOME:-${HOME:-}/.local/state}/flamewm/session.log"
    if [[ -f "$slog" ]]; then
        grep -aqi 'fatal' "$slog" && cause+="+preflight_fatal"
        grep -aqF 'DEGRADED' "$slog" && cause+="+degraded_components"
    fi
    [[ -n "${XDG_RUNTIME_DIR:-}" && ! -d "$XDG_RUNTIME_DIR" ]] && cause+="+runtime_dir"
    [[ -z "${DISPLAY:-}" ]] && cause+="+no_display"
    printf '%s' "$cause"
}

chain_works() { case "$1" in
    x11) printf 'x_server+x11_clients' ;;
    safe) printf 'shell+diagnostics' ;;
    minimal) printf 'x_server+x11_clients' ;;
esac; }
chain_degraded() { case "$1" in
    x11) printf 'wayland_native+compositor+kms_presentation' ;;
    safe) printf 'gui+shell+desktop+compositor' ;;
    minimal) printf 'shell+desktop+compositor' ;;
esac; }

# Last-resort minimal mode: only a window manager, with no shell, terminal or desktop components.
# Reached when the full session and the safe-mode shell/desktop have both failed, so the user is
# never left at a black greeter. An already-running safe-mode WM is reused when its pid is passed.
run_minimal_mode() { # [existing-wm-pid]
    local candidate pid="${1:-}" rc=1
    local -a children=()
    if [[ -z "$pid" ]]; then
        if [[ -z "${DISPLAY:-}" ]]; then
            for candidate in /tmp/.X11-unix/X*; do
                [[ -S "$candidate" ]] || continue
                export DISPLAY=":${candidate##*X}"
                break
            done
        fi
        if [[ -z "${DISPLAY:-}" ]] && command -v Xvfb >/dev/null 2>&1; then
            Xvfb :99 -screen 0 1024x768x24 >/dev/null 2>&1 &
            children+=($!)
            export DISPLAY=:99
        fi
        if [[ -n "${DISPLAY:-}" ]]; then
            for candidate in ${FLAMEWM_SAFE_WM:-} openbox fluxbox xfwm4 icewm matchbox-window-manager twm; do
                [[ -n "$candidate" ]] && command -v "$candidate" >/dev/null 2>&1 \
                    && { "$candidate" >/dev/null 2>&1 & pid=$!; children+=($pid); break; }
            done
        fi
    fi
    if [[ -n "$pid" ]]; then
        chain_record minimal ok shell_desktop_failed 0 "$(chain_works minimal)" \
            "$(chain_degraded minimal)" "wm_pid=$pid"
        wait "$pid"; rc=$?
    else
        chain_record minimal fail no_wm 1 "$(chain_works minimal)" "$(chain_degraded minimal)" \
            "no_display_or_wm"
    fi
    if (( ${#children[@]} > 0 )); then
        for candidate in "${children[@]}"; do kill -TERM "$candidate" 2>/dev/null || :; done
    fi
    return "$rc"
}

# Minimal safe mode: one usable display, a light window manager if one is installed, and one
# terminal (or xmessage). When the shell/desktop fails after the full session already failed,
# minimal mode keeps the WM alone alive before any VT recovery shell is attempted.
run_safe_mode() {
    local candidate child pid wm_pid="" rc=0
    local -a children=()
    if [[ -z "${DISPLAY:-}" ]]; then
        for candidate in /tmp/.X11-unix/X*; do
            [[ -S "$candidate" ]] || continue
            export DISPLAY=":${candidate##*X}"
            break
        done
    fi
    if [[ -z "${DISPLAY:-}" ]] && command -v Xvfb >/dev/null 2>&1; then
        Xvfb :99 -screen 0 1024x768x24 >/dev/null 2>&1 &
        children+=($!)
    fi
    if [[ -n "${DISPLAY:-}" ]]; then
        for candidate in ${FLAMEWM_SAFE_WM:-} openbox fluxbox xfwm4 icewm matchbox-window-manager twm; do
            [[ -n "$candidate" ]] && command -v "$candidate" >/dev/null 2>&1 \
                && { "$candidate" >/dev/null 2>&1 & wm_pid=$!; children+=($wm_pid); break; }
        done
        for candidate in ${FLAMEWM_SAFE_TERMINAL:-} xterm x-terminal-emulator alacritty xfce4-terminal konsole; do
            [[ -n "$candidate" ]] && command -v "$candidate" >/dev/null 2>&1 \
                && { "$candidate" -e /bin/sh >/dev/null 2>&1 & child=$!; children+=($child); break; }
        done
        if [[ -z "${child:-}" ]] && command -v xmessage >/dev/null 2>&1; then
            xmessage -center 'FlameWM safe mode: no terminal is installed. Check ~/.cache/flamewm/session-chain.log.' \
                >/dev/null 2>&1 & child=$!; children+=($child)
        fi
        [[ -n "${child:-}" ]] || rc=1
    else
        rc=1
    fi
    if (( rc == 0 )); then
        wait "$child"; rc=$?
    fi
    if (( rc != 0 )); then
        # Full session and safe-mode shell/desktop both failed: keep only the WM running.
        # Reuse the safe-mode WM when one was started so no second WM is spawned.
        run_minimal_mode "$wm_pid"; rc=$?
        if (( rc != 0 )); then
            printf 'FlameWM safe mode: no usable X display; starting a recovery shell.\n' >&2
            printf 'FlameWM safe mode: no usable X display; see ~/.cache/flamewm/session-chain.log\n' \
                >/dev/tty 2>/dev/null || :
            if [[ -t 0 ]]; then /bin/sh -i; rc=0; fi
        fi
    fi
    if (( ${#children[@]} > 0 )); then
        for pid in "${children[@]}"; do kill -TERM "$pid" 2>/dev/null || :; done
    fi
    return "$rc"
}

chain_supervisor() {
    local stage rc cause
    trap 'chain_forward TERM' TERM
    trap 'chain_forward INT' INT
    trap 'chain_forward HUP' HUP
    if chain_guard_trip; then
        chain_record guard fail crash_loop 0 "$(chain_works safe)" "$(chain_degraded safe)" \
            "attempts=$CHAIN_ATTEMPTS"
        preflight_libs "$SESSION" || : # record only; safe mode remains the last resort
        run_safe_mode; rc=$?
        # Keep counting while safe mode fails too; only a stage that actually came up clears the loop.
        if (( rc == 0 || rc == 129 || rc == 130 || rc == 143 )); then chain_clear_guard; fi
        return "$rc"
    fi
    for stage in x11 safe; do
        if [[ "$stage" == x11 ]]; then
            # Missing NEEDED libraries skip this backend; the chain then picks safe mode.
            if preflight_libs "$SESSION"; then
                env FLAMEWM_SESSION_ATTEMPT=x11 "$0" "$@" & CHAIN_CHILD=$!
                chain_wait "$CHAIN_CHILD"; rc=$?
                CHAIN_CHILD=""
            else
                rc=78
            fi
        else
            preflight_libs "$SESSION" || : # record only; safe mode remains the last resort
            run_safe_mode; rc=$?
        fi
        if (( rc == 0 || rc == 129 || rc == 130 || rc == 143 )); then
            chain_record "$stage" ok none 0 "$(chain_works "$stage")" "none" "chain_stopped"
            chain_clear_guard
            return 0
        fi
        cause="$(chain_cause "$stage" "$rc")"
        chain_record "$stage" fail "$cause" "$rc" "$(chain_works "$stage")" \
            "$(chain_degraded "$stage")" "next=$stage"
    done
    return "$rc"
}

if [[ "${FLAMEWM_SESSION_ATTEMPT:-}" == safe ]]; then
    run_safe_mode
    exit $?
fi
# Explicit last-resort entry: WM only, no shell or desktop components.
if [[ "${FLAMEWM_SESSION_ATTEMPT:-}" == minimal ]]; then
    run_minimal_mode
    exit $?
fi
CHAIN_WANTED=0
if [[ -z "${FLAMEWM_SESSION_ATTEMPT:-}" && "${1:-}" != "--check" ]]; then
    case "${FLAMEWM_SESSION_FALLBACK:-auto}" in
        1|yes|true|on) CHAIN_WANTED=1 ;;
        0|no|false|off) CHAIN_WANTED=0 ;;
        *) [[ -n "${XDG_SESSION_ID:-}${DESKTOP_SESSION:-}${XDG_SESSION_CLASS:-}${XDG_SESSION_TYPE:-}" ]] \
            && CHAIN_WANTED=1 ;;
    esac
fi
# Keep Plasma/KDE isolation: set FlameWM identity only when SDDM did not.
if [[ -z "${XDG_CURRENT_DESKTOP:-}" ]]; then export XDG_CURRENT_DESKTOP=FlameWM; fi
export XDG_MENU_PREFIX=flamewm-
SESSION="${FLAMEWM_SESSION_BINARY:-/usr/bin/flamewm-session}"
# Missing-library preflight: one failure record per unresolved NEEDED library with its blast
# radius, then hand the session to the next fallback stage instead of leaving a dead session.
# UNBUILT: this slice was syntax-checked with bash -n only; no session was started.
session_preflight_blast() { # soname -> "works degraded"
    case "${1%%.so*}" in
        libX11|libXi|libdbus-1|libc|libm|libgcc_s)
            printf '%s %s' "$(chain_works safe)" "$(chain_degraded safe)" ;;
        libxkbcommon)
            printf '%s %s' "$(chain_works x11)" "wayland_keyboard_layout" ;;
        libgbm|libdrm|libinput|libudev|libseat)
            printf '%s %s' "$(chain_works x11)" "wayland_drm_backend+kms_presentation" ;;
        libEGL|libGLESv2|libGL)
            printf '%s %s' "$(chain_works x11)" "wayland_gpu_renderer+x11_gpu_blur" ;;
        libpulse)
            printf '%s %s' "$(chain_works x11)" "audio_helper" ;;
        libpam)
            printf '%s %s' "$(chain_works x11)" "lock_authentication" ;;
        libfontconfig|libXft|libfreetype)
            printf '%s %s' "$(chain_works x11)" "text_fonts" ;;
        libwayland-client|libwayland-server|libwayland-egl)
            printf '%s %s' "$(chain_works x11)" "nested_wayland+wayland_lock" ;;
        *)
            printf '%s %s' "$(chain_works safe)" "unknown_component" ;;
    esac
}

session_preflight_record() { # stage status cause code works degraded [extra]
    local prefix line log_dir
    prefix="$(date '+%F %T' 2>/dev/null)"
    line="$prefix FLAMEWM-SESSION-CHAIN stage=$1 status=$2 cause=$3 code=$4 blast_radius=works:$5|degraded:$6 ms=$(chain_ms)"
    [[ -n "${7:-}" ]] && line+=" detail=$7"
    printf '%s\n' "$line" >&2
    [[ -n "$CHAIN_LOG" ]] && printf '%s\n' "$line" >>"$CHAIN_LOG" 2>/dev/null || :
    log_dir="${XDG_STATE_HOME:-${HOME:-}/.local/state}/flamewm"
    mkdir -p "$log_dir" 2>/dev/null || :
    printf '%s\n' "$line" >>"$log_dir/session.log" 2>/dev/null || :
}

# preflight_libs BIN: record every unresolved NEEDED library and return non-zero so the fallback
# chain skips this backend instead of exiting; the caller decides which backend comes next.
preflight_libs() { # bin -> 0 clean; non-zero when a missing-lib record was written
    local bin="${1:-}" missing lib works degraded rc=0
    command -v ldd >/dev/null 2>&1 || return 0
    [[ -x "$bin" ]] || return 0
    missing="$(ldd "$bin" 2>&1 | grep -F 'not found' || true)"
    [[ -n "$missing" ]] || return 0
    while IFS= read -r lib; do
        [[ -n "$lib" ]] || continue
        read -r works degraded < <(session_preflight_blast "$lib")
        session_preflight_record preflight fail missing_lib 78 "$works" "$degraded" \
            "lib=$lib binary=$bin"
        rc=1
    done < <(printf '%s\n' "$missing" | awk '/not found/ && !seen[$1]++ {print $1}')
    return "$rc"
}

session_preflight_missing_libs() { # [binary] -> 0 clean; otherwise the next fallback was selected and run
    local binary="${1:-$SESSION}" missing lib works degraded
    command -v ldd >/dev/null 2>&1 || return 0
    [[ -x "$binary" ]] || return 0
    missing="$(ldd "$binary" 2>&1 | grep -E 'not found|version .* not found' || true)"
    [[ -n "$missing" ]] || return 0

    while IFS= read -r lib; do
        [[ -n "$lib" ]] || continue
        read -r works degraded < <(session_preflight_blast "$lib")
        session_preflight_record preflight fail missing_lib 78 "$works" "$degraded" \
            "lib=$lib binary=$binary"
    done < <(printf '%s\n' "$missing" | awk '/not found/ && !seen[$1]++ {print $1}')

    # The chain order is x11 -> safe. A compositor that cannot load its NEEDED libraries
    # hands off to the next stage instead of returning the old exit-78 dead end.
    session_preflight_record preflight fail missing_libs 78 \
        "$(chain_works safe)" "$(chain_degraded safe)" "next=safe"
    run_safe_mode
    return $?
}

if (( CHAIN_WANTED )); then
    chain_supervisor "$@"
    exit $?
fi

# Graceful startup check: name unresolved libraries or a too-old C library, then take the next
# fallback stage rather than exiting with a dead session.
session_preflight_missing_libs "$SESSION" || exit $?
# Preflight report only: no bridge, no components.
if [[ "${1:-}" == "--check" ]]; then exec "$SESSION" --check; fi
BRIDGE="${FLAMEWM_SERVICES_BINARY:-$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/flamewm-desktop-services}"
bridge_pid=""
session_pid=""
if [[ -x "$BRIDGE" ]]; then
    "$BRIDGE" --run & bridge_pid=$!
fi
"$SESSION" "$@" & session_pid=$!
forward() {
    trap - INT TERM HUP
    if [[ -n "$session_pid" ]]; then kill -TERM "$session_pid" 2>/dev/null || :; fi
}
trap forward INT TERM HUP
wait "$session_pid"; result=$?
if [[ -n "$bridge_pid" ]]; then
    kill -TERM "$bridge_pid" 2>/dev/null || :
    wait "$bridge_pid" 2>/dev/null || :
fi
exit "$result"
