#!/usr/bin/env bash
set -euo pipefail

usage(){
  cat <<'EOF'
Usage: scripts/xephyr

Launch the FlameWM Xephyr development session. No arguments are accepted.

Environment controls include:
  FLAMEWM_XEPHYR_PRIVATE_DBUS=0   Opt out of the default private D-Bus session
  FLAMEWM_XEPHYR_SCREEN=WxH       Nested display geometry (default: 1350x641)
  FLAMEWM_XEPHYR_DISPLAY=:N       Select a nested X display (default: auto)
  FLAMEWM_XEPHYR_CANARY=1         Run bounded canary checks
  FLAMEWM_XEPHYR_TEST_APPS=1      Start optional test application
  FLAMEWM_XEPHYR_HARD_T06=1       Require hard T06 move and T07 resize canaries
  FLAMEWM_XEPHYR_SESSION_MODE=1   Run flamewm-session as sole supervisor (default: direct WM/desktop/shell)
  FLAMEWM_XEPHYR_BUILD=0          Skip Cargo build when selected binaries are executable
  FLAMEWM_XEPHYR_SESSION_BIN=PATH Override flamewm-session binary in session mode
  FLAMEWM_XEPHYR_WM_BIN=PATH      Override direct WM binary
  FLAMEWM_XEPHYR_DESKTOP_BIN=PATH Override direct desktop binary
  FLAMEWM_XEPHYR_SHELL_BIN=PATH   Override direct shell binary
  FLAMEWM_XEPHYR_CANARY_BIN=PATH  Override X11 canary binary
  FLAMEWM_XEPHYR_DEBUG_CRASH=1    Enable crash-debug Rust environment
  FLAMEWM_XEPHYR_OUTPUT_DIR=PATH  Root for invocation logs and screenshots
  FLAMEWM_XEPHYR_EVIDENCE_ROOT=PATH Root for profiler evidence (default: .performance)
  FLAMEWM_XEPHYR_DEBUG_ROOT=PATH  Root for debug logs (default: .debug)
  FLAMEWM_DEBUG=0                 Disable development debug logging
  FLAMEWM_PROFILE=0               Disable development profiling
EOF
}

if [[ "$#" -gt 0 ]]; then
  if [[ "$#" -eq 1 && ( "$1" == "--help" || "$1" == "-h" ) ]]; then
    usage
    exit 0
  fi
  usage >&2
  printf 'error: unknown argument: %s\n' "$1" >&2
  exit 2
fi

# J01 private nested D-Bus: outer invocation re-execs the harness under a
# private session bus so the nested WM never touches the host bus.
# Default ON; FLAMEWM_XEPHYR_PRIVATE_DBUS=0 opts out (debugging only).
export XDG_MENU_PREFIX=flamewm-
if [[ "${FLAMEWM_XEPHYR_PRIVATE_DBUS_INNER:-}" != "1" ]]; then
  if [[ "${FLAMEWM_XEPHYR_PRIVATE_DBUS:-1}" == "0" ]]; then
    export FLAMEWM_XEPHYR_PRIVATE_DBUS_INNER=1
    exec "$0" "$@"
  fi
  if ! command -v dbus-run-session >/dev/null 2>&1; then
    echo 'FLAMEWM_XEPHYR_ENVIRONMENT-BLOCKED: dbus-run-session missing; private D-Bus required (opt out with FLAMEWM_XEPHYR_PRIVATE_DBUS=0 for debugging only)' >&2
    exit 3
  fi
  export FLAMEWM_XEPHYR_PRIVATE_DBUS_INNER=1
  exec dbus-run-session -- "$0" "$@"
fi
ROOT="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd -P)"
cd "$ROOT"
# Cargo and the nested session must use the SAME release directory. Previously
# Cargo honored CARGO_TARGET_DIR but the launcher always used .target/release,
# silently running an older Settings/WM/Shell after a successful build.
TARGET_DIR="${CARGO_TARGET_DIR:-$ROOT/.target}"
if [[ "$TARGET_DIR" != /* ]]; then
  TARGET_DIR="$ROOT/$TARGET_DIR"
fi
export CARGO_TARGET_DIR="$TARGET_DIR"
# Checkout binaries shadow PATH only for checkout builds; FLAMEWM_XEPHYR_BUILD=0
# leaves bare-name lookups to the installed prefix.
if [[ "${FLAMEWM_XEPHYR_BUILD:-1}" != 0 ]]; then
  export PATH="$TARGET_DIR/release:$PATH"
fi
command -v cargo >/dev/null || { echo 'cargo is required' >&2; exit 1; }
command -v Xephyr >/dev/null || { echo 'Xephyr is required (Ubuntu/Debian: xserver-xephyr)' >&2; exit 1; }
command -v xdpyinfo >/dev/null || { echo 'xdpyinfo is required (x11-utils)' >&2; exit 1; }
[[ -n "${DISPLAY:-}" ]] || { echo 'Host DISPLAY is unset; Xephyr needs the current X desktop.' >&2; exit 1; }

SCREEN="${FLAMEWM_XEPHYR_SCREEN:-1350x641}"
SESSION_MODE="${FLAMEWM_XEPHYR_SESSION_MODE:-0}"
BUILD="${FLAMEWM_XEPHYR_BUILD:-1}"
CANARY="${FLAMEWM_XEPHYR_CANARY:-0}"
CANARY_SECS="${FLAMEWM_XEPHYR_CANARY_SECS:-10}"
# Canary harness (flamewm-x11-canary): scenario selection for CANARY mode.
# Default runs all four: SR05 first-present, SR07 popup matrix, SR08 black-pixel, SR15 input matrix.
CANARY_SCENARIOS="${FLAMEWM_XEPHYR_CANARY_SCENARIOS:-sr05,sr07,sr08,sr15}"
IFS=',' read -r -a selected_scenarios <<<"$CANARY_SCENARIOS"
for scenario in "${selected_scenarios[@]}"; do
  case "$scenario" in sr05|sr07|sr08|sr15) ;; *) echo "Unsupported canary scenario: $scenario" >&2; exit 2 ;; esac
done
CANARY_NAME="${FLAMEWM_XEPHYR_CANARY_NAME:-flame}"
CANARY_JSON="${FLAMEWM_XEPHYR_CANARY_JSON:-0}"
HARD_T06="${FLAMEWM_XEPHYR_HARD_T06:-0}"
# Off by default: when enabled, run FlameWM children with crash-debug friendly
# Rust env so a segfault produces a full backtrace. Does not change normal runs.
DEBUG_CRASH="${FLAMEWM_XEPHYR_DEBUG_CRASH:-0}"
CRASH_ENV_EXTRA=()
if [[ "$DEBUG_CRASH" == 1 ]]; then
  CRASH_ENV_EXTRA=(RUST_BACKTRACE=full RUST_BACKTRACE_ON_ABORT=1 RUST_MIN_STACK=8m)
  echo '[debug-crash] running FlameWM children with RUST_BACKTRACE=full (FLAMEWM_XEPHYR_DEBUG_CRASH=1)' >&2
fi
export RWR_UI_FONT="${RWR_UI_FONT:-IBM Plex Sans}"
if [[ -z "${RWR_FONT_FILES:-}" ]]; then
  files="$(./scripts/prepare-ibm-plex || true)"
  [[ -n "$files" ]] && export RWR_FONT_FILES="$files"
fi
VERSION="$("$ROOT/scripts/version")"

OUTPUT_DIR="${FLAMEWM_XEPHYR_OUTPUT_DIR:-$ROOT/.target/flamewm}"
mkdir -p "$OUTPUT_DIR"
WM_BIN="${FLAMEWM_XEPHYR_WM_BIN:-$TARGET_DIR/release/flamewm}"
DESKTOP_BIN="${FLAMEWM_XEPHYR_DESKTOP_BIN:-$TARGET_DIR/release/flamewm-desktop}"
SHELL_BIN="${FLAMEWM_XEPHYR_SHELL_BIN:-$TARGET_DIR/release/flamewm-shell}"
SESSION_BIN="${FLAMEWM_XEPHYR_SESSION_BIN:-$TARGET_DIR/release/flamewm-session}"
CANARY_BIN="${FLAMEWM_XEPHYR_CANARY_BIN:-$TARGET_DIR/release/flamewm-x11-canary}"
SETTINGS_BIN="$TARGET_DIR/release/flamewm-settings"
if [[ "$BUILD" == 1 ]]; then
  # Fail early when desktop UI and core were merged from different FlameWM passes.
  # Otherwise Cargo reports E0432/E0599/E0061 deep into a full release build.
  python3 -I tools/verify_desktop_conversion_contract.py
  # Catch strict RWR-incompatible Convert wheel CSS before costly Cargo cache cleanup.
  python3 -I tools/test_desktop_convert_css_contract.py -q
  # Cargo may reuse pre-Convert desktop-core rlibs after an archive extraction
  # restores source mtimes older than the previous build. Verify the path crate
  # and invalidate only its release cache on a source-content change.
  python3 -I tools/ensure_desktop_conversion_cargo.py --profile release --include-ui
  echo "[1/5] Building FlameWM WM + desktop + shell + settings + Explorer + X11 canary"
  cargo build --quiet --release -p flamewm-wm -p flamewm-desktop -p flamewm-shell -p flamewm-settings -p flamewm-explorer -p flamewm-terminal -p flamewm-x11-canary
  # The Settings UI is embedded into the executable at compile time. Assert
  # that the exact binary Xephyr will launch contains the newly added control;
  # a successful Cargo exit must not masquerade as a successful UI update.
  if [[ ! -x "$SETTINGS_BIN" ]]; then
    echo "FLAMEWM_XEPHYR_FAIL: Settings build missing: $SETTINGS_BIN" >&2
    exit 1
  fi
  if ! LC_ALL=C grep -aFq 'taskbar-separate-on' "$SETTINGS_BIN" || \
     ! LC_ALL=C grep -aFq 'Separate taskbar' "$SETTINGS_BIN"; then
    echo "FLAMEWM_XEPHYR_FAIL: Settings binary lacks compiled Separate taskbar markup: $SETTINGS_BIN" >&2
    echo "Check the Cargo target directory and ui/settings.html compilation; refusing to launch stale UI." >&2
    exit 1
  fi
  echo "[settings] checkout executable verified: $SETTINGS_BIN"
  echo "[settings] PATH resolution: $(command -v flamewm-settings)"
elif [[ "$BUILD" != 0 ]]; then
  echo "FLAMEWM_XEPHYR_BUILD must be 0 or 1" >&2; exit 2
fi
if [[ "$SESSION_MODE" == 1 ]]; then
  [[ -x "$SESSION_BIN" ]] || { echo "missing or non-executable session binary: $SESSION_BIN" >&2; exit 1; }
  [[ -x "$CANARY_BIN" ]] || { echo "missing or non-executable canary binary: $CANARY_BIN" >&2; exit 1; }
elif [[ "$SESSION_MODE" == 0 ]]; then
  [[ -x "$WM_BIN" ]] || { echo "missing or non-executable WM binary: $WM_BIN" >&2; exit 1; }
  [[ -x "$DESKTOP_BIN" ]] || { echo "missing or non-executable desktop binary: $DESKTOP_BIN" >&2; exit 1; }
  [[ -x "$SHELL_BIN" ]] || { echo "missing or non-executable shell binary: $SHELL_BIN" >&2; exit 1; }
  [[ -x "$CANARY_BIN" ]] || { echo "missing or non-executable canary binary: $CANARY_BIN" >&2; exit 1; }
else
  echo "FLAMEWM_XEPHYR_SESSION_MODE must be 0 or 1" >&2; exit 2
fi

if [[ -n "${FLAMEWM_XEPHYR_DISPLAY:-}" ]]; then
  nested="${FLAMEWM_XEPHYR_DISPLAY}"
  [[ "$nested" == :* ]] || nested=":$nested"
else
  nested=''
  for n in $(seq 97 119); do
    candidate=":$n"
    if ! DISPLAY="$candidate" xdpyinfo >/dev/null 2>&1; then nested="$candidate"; break; fi
  done
  [[ -n "$nested" ]] || { echo 'No free display in :97..:119' >&2; exit 1; }
fi
if DISPLAY="$nested" xdpyinfo >/dev/null 2>&1; then echo "$nested is already in use" >&2; exit 1; fi

INVOCATION_ID="$(date -u +%Y%m%dT%H%M%SZ)-$$"
LOG_DIR="$OUTPUT_DIR/$INVOCATION_ID"
mkdir -p "$LOG_DIR"
xephyr_log="$LOG_DIR/xephyr.log"
wm_log="$LOG_DIR/wm.log"
desktop_log="$LOG_DIR/desktop.log"
shell_log="$LOG_DIR/shell.log"
session_log="$LOG_DIR/session.log"
: >"$xephyr_log"; : >"$wm_log"; : >"$desktop_log"; : >"$shell_log"; : >"$session_log"

# C03 debug logs: never delete history here; each run gets its own
# `.debug/$RUN_ID` dir (see below); retention prunes old runs only.
# Xephyr dev default: debug logging on; direct product start stays off
# unless the caller exports FLAMEWM_DEBUG=1 (flamewm-debug default).
: "${FLAMEWM_DEBUG:=1}"
export FLAMEWM_DEBUG

# Xephyr dev default: profiling on with tight cadence; direct product start
# stays off unless the caller exports FLAMEWM_PROFILE=1 (profiler default).
: "${FLAMEWM_PROFILE:=1}"
: "${FLAMEWM_PROFILE_INTERVAL:=10}"
: "${FLAMEWM_PROFILE_TOP:=8}"
export FLAMEWM_PROFILE FLAMEWM_PROFILE_INTERVAL FLAMEWM_PROFILE_TOP

# J11 .performance evidence run directory pipeline.
# Profiler owns formatting/append; this harness owns lifecycle only.
RUN_ID="$(date -u +%Y%m%dT%H%M%SZ)-$$"
EVIDENCE_ROOT="${FLAMEWM_XEPHYR_EVIDENCE_ROOT:-$ROOT/.performance}"
DEBUG_ROOT="${FLAMEWM_XEPHYR_DEBUG_ROOT:-$ROOT/.debug}"
ISOLATED_OUTPUT=0
if [[ -n "${FLAMEWM_XEPHYR_OUTPUT_DIR:-}" || -n "${FLAMEWM_XEPHYR_EVIDENCE_ROOT:-}" || -n "${FLAMEWM_XEPHYR_DEBUG_ROOT:-}" ]]; then
  ISOLATED_OUTPUT=1
fi
RUN_DIR="$EVIDENCE_ROOT/$RUN_ID"
mkdir -p "$RUN_DIR"
export FLAMEWM_PROFILE_DIR="$RUN_DIR"
# F20 debug run dir: per-run debug logs under .debug/$RUN_ID; never rm -rf.
DEBUG_RUN_DIR="$DEBUG_ROOT/$RUN_ID"
mkdir -p "$DEBUG_RUN_DIR"
export FLAMEWM_DEBUG_DIR="$DEBUG_RUN_DIR"
ln -sfn "$DEBUG_RUN_DIR" "$DEBUG_ROOT/latest" 2>/dev/null || true
# Bounded debug retention: keep latest + previous 9, never current run.
run_debug_retention(){
  if [[ "$ISOLATED_OUTPUT" == 1 ]]; then return 0; fi
  if [[ ! -f tools/debug_retention.py ]]; then
    echo "xephyr: tools/debug_retention.py missing; debug retention skipped" >&2
    return 0
  fi
  FLAMEWM_CURRENT_RUN="${RUN_ID:-}" python3 tools/debug_retention.py "$DEBUG_ROOT" 2>/dev/null || true
}
run_debug_retention
# Manifest: run identity + environment (best-effort fields never fail the run).
{
  echo "run_id=$RUN_ID"
  echo "head=$(git -C "$ROOT" rev-parse HEAD 2>/dev/null || echo unknown)"
  echo "branch=$(git -C "$ROOT" rev-parse --abbrev-ref HEAD 2>/dev/null || echo unknown)"
  echo "dirty=$(git -C "$ROOT" status --short 2>/dev/null | sha256sum | cut -d' ' -f1 || echo unknown)"
  echo "version=$VERSION"
  echo "display=${FLAMEWM_XEPHYR_DISPLAY:-auto}"
  echo "geometry=$SCREEN"
  echo "profile=$([ "${FLAMEWM_PROFILE:-1}" = 1 ] && echo 1 || echo 0)"
  echo "profile_interval=${FLAMEWM_PROFILE_INTERVAL:-10}"
  echo "profile_top=${FLAMEWM_PROFILE_TOP:-8}"
  echo "xcursor_theme=${FLAMEWM_CURSOR_THEME:-auto (McMojave/Oxygen/Breeze)}"
  echo "xcursor_size=${FLAMEWM_CURSOR_SIZE:-24}"
  echo "xcursor_path=${FLAMEWM_CURSOR_PATH:-$ROOT/.target/stage-icons}"
  echo "command=$0 $*"
  echo "dbus_mode=$([ "${FLAMEWM_XEPHYR_PRIVATE_DBUS:-1}" = "0" ] && echo optout || echo private)"
  echo "dbus_inner=${FLAMEWM_XEPHYR_PRIVATE_DBUS_INNER:-0}"
  echo "dbus_session_present=$([ -n "${DBUS_SESSION_BUS_ADDRESS:-}" ] && echo 1 || echo 0)"
  echo "dbus_session_hash=$(printf '%s' "${DBUS_SESSION_BUS_ADDRESS:-none}" | sha256sum | cut -d' ' -f1)"
  echo "rustc=$(rustc --version 2>/dev/null || echo unknown)"
  echo "cargo=$(cargo --version 2>/dev/null || echo unknown)"
} >"$RUN_DIR/manifest.txt" 2>/dev/null || true
ln -sfn "$RUN_DIR" "$EVIDENCE_ROOT/latest" 2>/dev/null || true
# Crash-debug environment record (never fails the run).
{
  echo "ulimit_c=$(ulimit -c 2>/dev/null || echo unknown)"
  echo "core_pattern=$(cat /proc/sys/kernel/core_pattern 2>/dev/null || echo unknown)"
  if command -v coredumpctl >/dev/null 2>&1; then echo "coredumpctl=yes"; else echo "coredumpctl=no"; fi
  if command -v gdb >/dev/null 2>&1; then echo "gdb=yes $(gdb --version 2>/dev/null | head -n 1 || true)"; else echo "gdb=no"; fi
  echo "gdb_child=${FLAMEWM_XEPHYR_GDB_CHILD:-none}"
} >"$RUN_DIR/crash-env.txt" 2>/dev/null || true
# Bounded retention: on by default (FLAMEWM_PERFORMANCE_CLEANUP=1).
# Never fails run.
run_retention(){
  if [[ "$ISOLATED_OUTPUT" == 1 ]]; then return 0; fi
  if [[ -x tools/performance_retention.py || -f tools/performance_retention.py ]]; then
    FLAMEWM_CURRENT_RUN="${RUN_ID:-}" python3 tools/performance_retention.py "$EVIDENCE_ROOT" 2>/dev/null || true
  fi
}
run_retention
# Optional gdb wrapper: FLAMEWM_XEPHYR_GDB_CHILD=wm|desktop|shell runs that
# child under gdb, capturing a real backtrace to $RUN_DIR/<child>.gdb.log.
GDB_CHILD="${FLAMEWM_XEPHYR_GDB_CHILD:-}"
gdb_has_return_child_result(){
  gdb --help 2>/dev/null | grep -q 'return-child-result'
}
launch_child(){
  local name="$1" bin="$2" log="$3"
  if [[ "${GDB_CHILD:-}" == "$name" ]] && command -v gdb >/dev/null 2>&1; then
    local gdb_log="$RUN_DIR/$name.gdb.log"
    echo "[gdb] wrapping $name under gdb -> $gdb_log" >&2
    echo "[gdb] wrapped; full output in $name.gdb.log" >>"$log" 2>/dev/null || true
    if gdb_has_return_child_result; then
      nested_env gdb -batch -return-child-result -ex run -ex bt --args "$bin" >"$gdb_log" 2>&1
    else
      nested_env gdb -batch -ex run -ex bt --args "$bin" >"$gdb_log" 2>&1
    fi
  else
    nested_env "$bin" >"$log" 2>&1
  fi
}
# Evidence collection: copy logs, best-effort PSS, canary screenshot,
# profile summary. Never hides exit codes; never deletes old runs.
collect_evidence(){
  [[ -n "${RUN_DIR:-}" ]] || return 0
  [[ -d "${RUN_DIR:-}" ]] || return 0
  for f in "$xephyr_log" "$wm_log" "$desktop_log" "$shell_log" "$session_log"; do
    cp "$f" "$RUN_DIR/$(basename "$f")" 2>/dev/null || true
  done
  # F20: collect per-run debug logs + manifest link into evidence.
  if [[ -d "${FLAMEWM_DEBUG_DIR:-}" ]]; then
    mkdir -p "$RUN_DIR/debug" 2>/dev/null || true
    cp "${FLAMEWM_DEBUG_DIR:-}"/*.log "$RUN_DIR/debug/" 2>/dev/null || true
  fi
  echo "debug_dir=$DEBUG_RUN_DIR" >>"$RUN_DIR/manifest.txt" 2>/dev/null || true
  echo "session_mode=$SESSION_MODE session_pid=${session_pid:-}" >>"$RUN_DIR/manifest.txt" 2>/dev/null || true
  for rec in "wm:${wm_pid:-}" "desktop:${desktop_pid:-}" "shell:${shell_pid:-}"; do
    name="${rec%%:*}"; pid="${rec##*:}"
    [[ -n "$pid" && -r "/proc/$pid/smaps_rollup" ]] || continue
    awk '/^Pss:/{pss=$2} /^Rss:/{rss=$2} /^Swap:/{sw=$2} END{printf "%s pid=%s pss=%dkB rss=%dkB swap=%dkB\n", "'"${name}"'", "'"${pid}"'", pss+0, rss+0, sw+0}' \
      "/proc/$pid/smaps_rollup" >>"$RUN_DIR/pss.txt" 2>/dev/null || true
  done
  [[ -s "$OUTPUT_DIR/canary-root.png" ]] && cp "$OUTPUT_DIR/canary-root.png" "$RUN_DIR/root.png" 2>/dev/null || true
  if [[ -x tools/profile_summary.py ]]; then    shopt -s nullglob
    prof_logs=("$RUN_DIR"/*.profile.log)
    shopt -u nullglob
    if [[ "${#prof_logs[@]}" -gt 0 ]]; then
      python3 tools/profile_summary.py "$wm_log" "$desktop_log" "$shell_log" "${prof_logs[@]}" >"$RUN_DIR/summary.txt" 2>/dev/null || true
    else
      python3 tools/profile_summary.py "$wm_log" "$desktop_log" "$shell_log" >"$RUN_DIR/summary.txt" 2>/dev/null || true
    fi
  fi
  run_retention
}

xephyr_pid=''
session_pid=''
wm_pid=''
desktop_pid=''
shell_pid=''
xterm_pid=''
cleanup(){
  if [[ -n "${xterm_pid:-}" ]]; then
    kill -TERM "$xterm_pid" 2>/dev/null || true
    for _ in $(seq 1 100); do
      kill -0 "$xterm_pid" 2>/dev/null || break
      sleep 0.1
    done
    if kill -0 "$xterm_pid" 2>/dev/null; then
      echo "xterm exceeded 10s shutdown bound; sending KILL to pid=$xterm_pid" >&2
      kill -KILL "$xterm_pid" 2>/dev/null || true
    fi
    wait "$xterm_pid" 2>/dev/null || true
  fi
  if [[ -n "${session_pid:-}" ]]; then
    kill -TERM "$session_pid" 2>/dev/null || true
    for _ in $(seq 1 100); do
      kill -0 "$session_pid" 2>/dev/null || break
      sleep 0.1
    done
    if kill -0 "$session_pid" 2>/dev/null; then
      echo "session supervisor exceeded 10s shutdown bound; sending KILL to pid=$session_pid" >&2
      kill -KILL "$session_pid" 2>/dev/null || true
    fi
    wait "$session_pid" 2>/dev/null || true
  else
    [[ -n "${shell_pid:-}" ]] && kill "$shell_pid" 2>/dev/null || true
    [[ -n "${desktop_pid:-}" ]] && kill "$desktop_pid" 2>/dev/null || true
    [[ -n "${wm_pid:-}" ]] && kill "$wm_pid" 2>/dev/null || true
  fi
  [[ -n "${xephyr_pid:-}" ]] && kill "$xephyr_pid" 2>/dev/null || true
  [[ -n "${shell_pid:-}" ]] && wait "$shell_pid" 2>/dev/null || true
  [[ -n "${desktop_pid:-}" ]] && wait "$desktop_pid" 2>/dev/null || true
  [[ -n "${wm_pid:-}" ]] && wait "$wm_pid" 2>/dev/null || true
  [[ -n "${xephyr_pid:-}" ]] && wait "$xephyr_pid" 2>/dev/null || true
}
trap 'collect_evidence; cleanup' EXIT INT TERM

fail(){
  echo "FLAMEWM_XEPHYR_FAIL: $*" >&2
  if [[ -n "${RUN_DIR:-}" && -d "${RUN_DIR:-}" ]]; then
    echo "FLAMEWM_XEPHYR_FAIL: $*" >>"$RUN_DIR/crash.txt" 2>/dev/null || true
    first_dead_child >>"$RUN_DIR/crash.txt" 2>&1 || true
  fi
  for f in "$xephyr_log" "$wm_log" "$desktop_log" "$shell_log" "$session_log"; do
    echo "--- tail $f ---" >&2
    tail -n 30 "$f" >&2 || true
  done
  exit 1
}

# Real crash capture: gdb-wrapped child already wrote $RUN_DIR/<name>.gdb.log;
# otherwise report any core via coredumpctl, or a clear NO-CORE verdict.
crash_capture(){
  local pid="$1" name="$2"
  local gdb_log="${RUN_DIR:-}/$name.gdb.log"
  if [[ -n "${RUN_DIR:-}" && -s "$gdb_log" ]]; then
    echo "crash-capture: gdb backtrace for $name in evidence ($name.gdb.log):" >&2
    tail -n 30 "$gdb_log" >&2 || true
    return 0
  fi
  if command -v coredumpctl >/dev/null 2>&1; then
    if coredumpctl info "$pid" >/dev/null 2>&1; then
      echo "crash-capture: core recorded for pid=$pid ($name); collect with:" >&2
      echo "  coredumpctl gdb $pid" >&2
      coredumpctl info "$pid" 2>/dev/null | head -n 20 >&2 || true
    else
      echo "crash-capture: NO-CORE for pid=$pid ($name) (coredumpctl has no dump; core_pattern=$(cat /proc/sys/kernel/core_pattern 2>/dev/null || echo unknown))" >&2
    fi
  elif command -v gdb >/dev/null 2>&1; then
    echo "crash-capture: NO-CORE for pid=$pid ($name) (no gdb-wrapped log, no coredumpctl; rerun with FLAMEWM_XEPHYR_GDB_CHILD=$name)" >&2
  else
    echo "crash-capture: NO-CORE for pid=$pid ($name) (no gdb/coredumpctl; set FLAMEWM_XEPHYR_DEBUG_CRASH=1 and rerun for RUST_BACKTRACE)" >&2
  fi
}

# Classify the first supervised child that has exited. Each child is waited
# once (binaries kill 0 cannot reap), so the pid -> status -> signal mapping is
# exact and is NOT confused with the later Xephyr teardown during cleanup.
first_dead_child(){
  local rec name pid status sig
  for rec in "session:$session_pid" "wm:$wm_pid" "desktop:$desktop_pid" "shell:$shell_pid" "xephyr:$xephyr_pid"; do
    name="${rec%%:*}"
    pid="${rec##*:}"
    if [[ -n "$pid" ]] && ! kill -0 "$pid" 2>/dev/null; then
      status='?'
      if wait "$pid" 2>/dev/null; then
        status=0
      else
        status=$?
      fi
      sig='none'
      if [[ "$status" -gt 128 ]] && command -v kill >/dev/null 2>&1; then
        sig="$(kill -l "$((status-128))" 2>/dev/null || echo "signal $((status-128))")"
      fi
      echo "FIRST-DEAD-CHILD pid=$pid name=$name exit_status=$status signal=$sig" >&2
      if [[ "$name" == xephyr ]]; then
        echo "NOTE: Xephyr itself exited; remaining clients will report the display connection broken during cleanup (secondary, expected)." >&2
      else
        echo "NOTE: primary child ($name) died; any 'X connection to :.. broken' that follows during cleanup is secondary/expected teardown, not the root cause." >&2
        crash_capture "$pid" "$name"
      fi
      return 0
    fi
  done
  return 1
}

require_alive(){
  local name="$1" pid="$2" log="$3"
  kill -0 "$pid" 2>/dev/null || fail "$name exited early; see $log"
}

# Nested X11 app env: force clients onto the Xephyr display and off the host
# Wayland compositor; identify the session as an X11 FlameWM session.
# J11 production appearance/session consumer: same env the flamewm launcher
# applies — FlameWM identity (never KDE), XCURSOR_* cursor theme (bundled
# McMojave -> Oxygen -> emergency Breeze fallback), and the guarded toolkit theme
# (explicit user values pass through; harness never selects toolkit styles).
session_appearance_env(){
  : "${FLAMEWM_CURSOR_SIZE:=24}"
  : "${FLAMEWM_CURSOR_PATH:=$ROOT/.target/stage-icons}"
  # Stage only assets actually present in this checkout. Never touch user or
  # system theme directories; a preexisting dev-stage entry is also preserved.
  if [[ "$FLAMEWM_CURSOR_PATH" == "$ROOT/.target/stage-icons" ]]; then
    mkdir -p "$FLAMEWM_CURSOR_PATH"
    if [[ -d "$ROOT/assets/cursors/cursors" \
          && ! -e "$FLAMEWM_CURSOR_PATH/FlameWM-Breeze-Dark" \
          && ! -L "$FLAMEWM_CURSOR_PATH/FlameWM-Breeze-Dark" ]]; then
      ln -s "$ROOT/assets/cursors" "$FLAMEWM_CURSOR_PATH/FlameWM-Breeze-Dark"
    fi
    for source in "$ROOT"/assets/themes/cursors/*; do
      [[ -d "$source/cursors" && -f "$source/index.theme" && -f "$source/cursors/left_ptr" ]] || continue
      theme="${source##*/}"
      case "${theme,,}" in
        mcmojave|mcmojave[-_]*|oxygen|oxygen[-_]*|oxy|oxy[-_]*) ;;
        *) continue ;;
      esac
      if [[ ! -e "$FLAMEWM_CURSOR_PATH/$theme" && ! -L "$FLAMEWM_CURSOR_PATH/$theme" ]]; then
        ln -s "$source" "$FLAMEWM_CURSOR_PATH/$theme"
      fi
    done
  fi
  # Resolve against the same Xcursor roots as native clients. An explicit
  # installed theme, even a third-party saved choice, must not be discarded.
  local cursor_root candidate theme
  local -a cursor_roots=() candidates=()
  IFS=: read -r -a cursor_roots <<<"$FLAMEWM_CURSOR_PATH:${XCURSOR_LIBRARY_PATH:-/usr/share/icons:/usr/share/pixmaps}:${XDG_DATA_HOME:-${HOME:-/nonexistent}/.local/share}/icons:${HOME:-/nonexistent}/.icons"
  cursor_is_installed(){
    local root
    [[ -n "$1" && "$1" != *'/'* && "$1" != *'\'* && "$1" != '.' && "$1" != '..' ]] || return 1
    for root in "${cursor_roots[@]}"; do
      [[ -d "$root/$1/cursors" ]] && return 0
    done
    return 1
  }
  cursor_pointer_exists(){
    local root
    for root in "${cursor_roots[@]}"; do
      [[ -f "$root/$1/cursors/left_ptr" ]] && return 0
    done
    return 1
  }
  local selected="${FLAMEWM_CURSOR_THEME:-}"
  # Follow the same persisted preference the WM reads when no explicit env
  # override exists; the nested process env must not preselect another theme.
  if [[ -z "$selected" ]]; then
    local config_dir="${FLAMEWM_CONFIG_DIR:-${XDG_CONFIG_HOME:-${HOME:-/nonexistent}/.config}/flamewm}"
    local settings_file="$config_dir/settings.toml" line
    if [[ -f "$settings_file" ]]; then
      while IFS= read -r line; do
        case "$line" in
          cursorTheme=*) selected="${line#cursorTheme=}" ;;
        esac
      done < "$settings_file"
    fi
  fi
  if [[ -z "$selected" ]]; then
    selected="${XCURSOR_THEME:-}"
  fi
  if ! cursor_is_installed "$selected"; then
    selected=''
    if cursor_is_installed McMojave-cursors && cursor_pointer_exists McMojave-cursors; then
      selected=McMojave-cursors
    else
      # Deterministic variant order if the canonical id is not installed.
      for cursor_root in "${cursor_roots[@]}"; do
        for candidate in "$cursor_root"/*; do
          [[ -d "$candidate/cursors" && -f "$candidate/cursors/left_ptr" ]] || continue
          theme="${candidate##*/}"
          case "${theme,,}" in
            mcmojave|mcmojave[-_]*) candidates+=("0:$theme") ;;
            oxygen|oxygen[-_]*|oxy|oxy[-_]*) candidates+=("1:$theme") ;;
          esac
        done
      done
      if ((${#candidates[@]})); then
        selected="$(printf '%s\n' "${candidates[@]}" | LC_ALL=C sort -f | sed -n '1p')"
        selected="${selected#*:}"
      fi
    fi
    if [[ -z "$selected" ]]; then
      selected=FlameWM-Breeze-Dark
    fi
  fi
  FLAMEWM_CURSOR_THEME="$selected"
  if ! cursor_is_installed "$FLAMEWM_CURSOR_THEME"; then
    echo "FLAMEWM_XEPHYR_FAIL: no usable cursor theme (McMojave, Oxygen or bundled Breeze) in configured roots" >&2
    return 1
  fi
  # Empty unless the user set it: an empty value is no override, so the WM resolves
  # env > persisted settings > Dark. A hard-coded dark here would override persisted light.
  : "${FLAMEWM_APPEARANCE:=}"
  export FLAMEWM_APPEARANCE
  case "$FLAMEWM_APPEARANCE" in
    dark|Dark|DARK) export FLAMEWM_DARK_MODE=1 ;;
    light|Light|LIGHT) export FLAMEWM_DARK_MODE=0 ;;
    *) export FLAMEWM_DARK_MODE=1 ;;
  esac
  export XCURSOR_THEME="${FLAMEWM_CURSOR_THEME}"
  export XCURSOR_SIZE="${FLAMEWM_CURSOR_SIZE}"
  export XCURSOR_PATH="$(IFS=:; echo "${cursor_roots[*]}")"
  export XCURSOR_THEME_CORE="${XCURSOR_THEME_CORE:-1}"
  if [[ "${XDG_CURRENT_DESKTOP:-}" == [Kk][Dd][Ee] ]] || [[ -z "${XDG_CURRENT_DESKTOP:-}" ]]; then
    export XDG_CURRENT_DESKTOP=FlameWM
  fi
  export FLAMEWM_DESKTOP=FlameWM
}
nested_env(){
  session_appearance_env
  if [[ "$DEBUG_CRASH" == 1 ]]; then
    env -u WAYLAND_DISPLAY -u WAYLAND_SOCKET DISPLAY="$nested" XDG_SESSION_TYPE=x11 XDG_CURRENT_DESKTOP="$XDG_CURRENT_DESKTOP" \
      FLAMEWM_DESKTOP="$FLAMEWM_DESKTOP" FLAMEWM_APPEARANCE="$FLAMEWM_APPEARANCE" FLAMEWM_DARK_MODE="$FLAMEWM_DARK_MODE" \
      XCURSOR_THEME="$XCURSOR_THEME" XCURSOR_SIZE="$XCURSOR_SIZE" XCURSOR_PATH="$XCURSOR_PATH" XCURSOR_THEME_CORE="$XCURSOR_THEME_CORE" \
      ${GTK_THEME:+GTK_THEME="$GTK_THEME"} ${QT_STYLE_OVERRIDE:+QT_STYLE_OVERRIDE="$QT_STYLE_OVERRIDE"} \
      "${CRASH_ENV_EXTRA[@]}" "$@"
  else
    env -u WAYLAND_DISPLAY -u WAYLAND_SOCKET DISPLAY="$nested" XDG_SESSION_TYPE=x11 XDG_CURRENT_DESKTOP="$XDG_CURRENT_DESKTOP" \
      FLAMEWM_DESKTOP="$FLAMEWM_DESKTOP" FLAMEWM_APPEARANCE="$FLAMEWM_APPEARANCE" FLAMEWM_DARK_MODE="$FLAMEWM_DARK_MODE" \
      XCURSOR_THEME="$XCURSOR_THEME" XCURSOR_SIZE="$XCURSOR_SIZE" XCURSOR_PATH="$XCURSOR_PATH" XCURSOR_THEME_CORE="$XCURSOR_THEME_CORE" \
      ${GTK_THEME:+GTK_THEME="$GTK_THEME"} ${QT_STYLE_OVERRIDE:+QT_STYLE_OVERRIDE="$QT_STYLE_OVERRIDE"} "$@"
  fi
}

# Nested children must never reach the host Wayland compositor, host GL, or host
# GTK/Qt portal and platform backends: force X11/XCB and software GL. Exported
# here so session-mode children inherit them too (nested_env covers direct mode).
unset WAYLAND_DISPLAY WAYLAND_SOCKET
export GDK_BACKEND=x11 GDK_DEBUG="${GDK_DEBUG:+$GDK_DEBUG,}no-portals" GTK_USE_PORTAL=0
export QT_QPA_PLATFORM=xcb QT_XCB_GL_INTEGRATION=none QT_QUICK_BACKEND=software QT_NO_XDG_DESKTOP_PORTAL=1
export LIBGL_ALWAYS_SOFTWARE=1
# Private XDG homes for nested apps: host ~/.config and ~/.local/share are not
# written or used for defaults. FlameWM config stays in the host profile path.
export FLAMEWM_CONFIG_DIR="${FLAMEWM_CONFIG_DIR:-${XDG_CONFIG_HOME:-${HOME:-/nonexistent}/.config}/flamewm}"
host_data_home="${XDG_DATA_HOME:-${HOME:-/nonexistent}/.local/share}"
NESTED_XDG_ROOT="$LOG_DIR/xdg"
export XDG_CONFIG_HOME="$NESTED_XDG_ROOT/config" XDG_DATA_HOME="$NESTED_XDG_ROOT/data"
mkdir -p "$XDG_CONFIG_HOME" "$XDG_DATA_HOME/applications"
# Cursor and icon lookups keep the host icon themes through a read-only link.
if [[ -d "$host_data_home/icons" && ! -e "$XDG_DATA_HOME/icons" ]]; then
  ln -s "$host_data_home/icons" "$XDG_DATA_HOME/icons"
fi
# Folder opens and the start menu use the nested Explorer entry, derived from
# the packaged desktop file with the resolved binary path.
explorer_bin="$TARGET_DIR/release/flamewm-explorer"
[[ -x "$explorer_bin" ]] || explorer_bin="$(command -v flamewm-explorer || true)"
if [[ -n "$explorer_bin" && -x "$explorer_bin" ]]; then
  sed -e "s|^Exec=flamewm-explorer|Exec=$explorer_bin|" -e "s|^TryExec=flamewm-explorer|TryExec=$explorer_bin|" \
    "$ROOT/packaging/flamewm-explorer.desktop" >"$XDG_DATA_HOME/applications/flamewm-explorer.desktop"
  # Folders resolve to Explorer only; Dolphin and other folder handlers are removed for nested apps.
  printf '[Default Applications]\ninode/directory=flamewm-explorer.desktop\n\n[Added Associations]\ninode/directory=flamewm-explorer.desktop;\n\n[Removed Associations]\ninode/directory=org.kde.dolphin.desktop;\n' >"$XDG_CONFIG_HOME/mimeapps.list"
else
  echo "[xephyr] flamewm-explorer not found; nested folder opens use the system handler" >&2
fi
# The nested Terminal entry makes 'Open Terminal Here' and the start menu find flamewm-terminal.
terminal_bin="$TARGET_DIR/release/flamewm-terminal"
[[ -x "$terminal_bin" ]] || terminal_bin="$(command -v flamewm-terminal || true)"
if [[ -n "$terminal_bin" && -x "$terminal_bin" ]]; then
  sed -e "s|^Exec=flamewm-terminal|Exec=$terminal_bin|" -e "s|^TryExec=flamewm-terminal|TryExec=$terminal_bin|" \
    "$ROOT/packaging/flamewm-terminal.desktop" >"$XDG_DATA_HOME/applications/flamewm-terminal.desktop"
else
  echo "[xephyr] flamewm-terminal not found; nested terminal entry is absent" >&2
fi

# Application discovery may prefer an installed .desktop entry with a stale
# absolute Exec=/usr/bin/flamewm-settings. Shadow it in the nested XDG home.
if [[ -x "$SETTINGS_BIN" ]]; then
  cat >"$XDG_DATA_HOME/applications/flamewm-settings.desktop" <<EOF
[Desktop Entry]
Type=Application
Name=System Settings
Comment=FlameWM checkout Settings for the nested Xephyr session
Exec=$SETTINGS_BIN
TryExec=$SETTINGS_BIN
Icon=preferences-system
Categories=Settings;System;
EOF
fi

echo "[2/5] Starting Xephyr $nested ($SCREEN)"
Xephyr "$nested" -screen "$SCREEN" -dpi 96 -ac -br -noreset -nolisten tcp -extension GLX -dumb -sw-cursor >"$xephyr_log" 2>&1 &
xephyr_pid=$!
for _ in $(seq 1 100); do
  kill -0 "$xephyr_pid" 2>/dev/null || fail "Xephyr exited during startup"
  DISPLAY="$nested" xdpyinfo >/dev/null 2>&1 && break
  sleep 0.05
done
DISPLAY="$nested" xdpyinfo >/dev/null 2>&1 || fail "Xephyr readiness failed"
if [[ -n "${FLAMEWM_XEPHYR_XTEST_OWNER_TOKEN:-}" || -n "${FLAMEWM_XEPHYR_XTEST_OWNER_MARKER:-}" ]]; then
  [[ "${FLAMEWM_XEPHYR_XTEST_OWNER_TOKEN:-}" =~ ^[0-9a-f]{64}$ && -n "${FLAMEWM_XEPHYR_XTEST_OWNER_MARKER:-}" ]] \
    || fail 'XTEST ownership token/marker configuration is invalid'
  printf '%s\n%s\n' "$nested" "$FLAMEWM_XEPHYR_XTEST_OWNER_TOKEN" >"$FLAMEWM_XEPHYR_XTEST_OWNER_MARKER"
fi

if [[ "$SESSION_MODE" == 1 ]]; then
  echo '[3/5] Starting flamewm-session supervisor (EWMH gate)'
  nested_env "$SESSION_BIN" >"$session_log" 2>&1 &
  session_pid=$!
else
  echo '[3/5] Starting FlameWM window manager (EWMH gate)'
  launch_child wm "$WM_BIN" "$wm_log" &
  wm_pid=$!
fi
wm_ready=0
for _ in $(seq 1 100); do
  if [[ "$SESSION_MODE" == 1 ]]; then require_alive session "$session_pid" "$session_log"; else require_alive wm "$wm_pid" "$wm_log"; fi
  if command -v xprop >/dev/null 2>&1 && DISPLAY="$nested" xprop -root _NET_SUPPORTING_WM_CHECK 2>/dev/null | grep -q '#'; then
    wm_ready=1
    break
  fi
  sleep 0.05
done
if [[ "$SESSION_MODE" == 1 ]]; then require_alive session "$session_pid" "$session_log"; else require_alive wm "$wm_pid" "$wm_log"; fi
if command -v xprop >/dev/null 2>&1; then
  [[ "$wm_ready" == 1 ]] || fail "WM EWMH readiness failed (_NET_SUPPORTING_WM_CHECK not published)"
else
  echo 'WARN: xprop missing; EWMH gate degraded to WM liveness only' >&2
fi

if [[ "$SESSION_MODE" == 0 ]]; then
  echo '[4/5] Starting FlameWM desktop'
  launch_child desktop "$DESKTOP_BIN" "$desktop_log" &
  desktop_pid=$!
  sleep 1
  require_alive desktop "$desktop_pid" "$desktop_log"
  require_alive wm "$wm_pid" "$wm_log"

  echo '[5/5] Starting FlameWM shell'
  launch_child shell "$SHELL_BIN" "$shell_log" &
  shell_pid=$!
  sleep 1
  require_alive shell "$shell_pid" "$shell_log"
  require_alive desktop "$desktop_pid" "$desktop_log"
  require_alive wm "$wm_pid" "$wm_log"
fi

hard_t06_active=0
if [[ "$HARD_T06" == 1 ]]; then
  hard_t06_active=1
elif [[ "${FLAMEWM_XEPHYR_TEST_APPS:-0}" == 1 ]]; then
  hard_t06_active=0
fi
if [[ "$HARD_T06" == 1 || "${FLAMEWM_XEPHYR_TEST_APPS:-0}" == 1 ]]; then
  command -v xterm >/dev/null 2>&1 || {
    [[ "$HARD_T06" == 1 ]] && fail 'hard T06/T07 lane requires xterm binary' || echo 'WARN: xterm missing; optional test app not started' >&2
  }
  if command -v xterm >/dev/null 2>&1; then
    nested_env xterm -T FlameWM-T06-Canary -n FlameWM-T06-Canary -geometry 80x24+90+90 >"$RUN_DIR/xterm.log" 2>&1 &
    xterm_pid=$!
  fi
fi

canary_checks(){
  [[ -x "$CANARY_BIN" ]] || fail "canary harness missing ($CANARY_BIN)"
  if [[ "$HARD_T06" == 1 ]]; then
    local hard_log="$RUN_DIR/hard-t06-t07.log"
    echo '[hard-canary] T06 move FlameWM-T06-Canary' | tee -a "$hard_log"
    if ! DISPLAY="$nested" "$CANARY_BIN" j07 --scenario move --name FlameWM-T06-Canary --timeout-secs 5 --json 2>&1 | tee -a "$hard_log"; then
      fail "hard T06 move canary failed (fixture unmapped, XTEST unsupported, or scenario failure); see $hard_log"
    fi
    echo '[hard-canary] T07 resize FlameWM-T06-Canary' | tee -a "$hard_log"
    if ! DISPLAY="$nested" "$CANARY_BIN" j07 --scenario resize --name FlameWM-T06-Canary --timeout-secs 5 --json 2>&1 | tee -a "$hard_log"; then
      fail "hard T07 resize canary failed (fixture unmapped, XTEST unsupported, or scenario failure); see $hard_log"
    fi
  fi
  json_flag=''
  [[ "$CANARY_JSON" == 1 ]] && json_flag='--json'
  # SR05 first-present: named Flame surface must be mapped/viewable.
  if [[ ",$CANARY_SCENARIOS," == *,sr05,* ]]; then
    # shellcheck disable=SC2086
    DISPLAY="$nested" "$CANARY_BIN" sr05 --name "$CANARY_NAME" --timeout-secs "$CANARY_SECS" $json_flag \
      || fail "canary SR05 first-present failed (name=$CANARY_NAME)"
  fi
  # SR07 popup matrix: enumerate small/top-level candidate popups.
  if [[ ",$CANARY_SCENARIOS," == *,sr07,* ]]; then
    # shellcheck disable=SC2086
    DISPLAY="$nested" "$CANARY_BIN" sr07 $json_flag \
      || fail "canary SR07 popup matrix failed"
  fi
  if command -v xprop >/dev/null 2>&1; then
    clients="$(DISPLAY="$nested" xprop -root _NET_CLIENT_LIST 2>/dev/null || true)"
    if echo "$clients" | grep -q '#'; then
      echo "canary: _NET_CLIENT_LIST present: $clients"
    else
      echo 'WARN: canary viewability skipped (_NET_CLIENT_LIST empty or unsupported)' >&2
    fi
  elif command -v xwininfo >/dev/null 2>&1; then
    tree="$(DISPLAY="$nested" xwininfo -root -tree 2>/dev/null || true)"
    [[ -n "$tree" ]] || fail "canary viewability failed (empty root tree)"
    echo 'canary: root window tree is non-empty'
  else
    echo 'WARN: canary viewability skipped (need xprop or xwininfo)' >&2
  fi
  # Screenshot black-frame rejection: canary sampler first (SR08),
  # then legacy shell-tool capture as a second opinion.
  # shellcheck disable=SC2086
  if [[ ",$CANARY_SCENARIOS," == *,sr08,* ]]; then
    DISPLAY="$nested" "$CANARY_BIN" sr08 $json_flag \
      || fail "canary SR08 black-pixel sampling failed"
  fi
  # SR15 input matrix: synthetic motion+click grid on the named surface.
  if [[ ",$CANARY_SCENARIOS," == *,sr15,* ]]; then
    if DISPLAY="$nested" "$CANARY_BIN" list --name "$CANARY_NAME" >/dev/null 2>&1; then
      # shellcheck disable=SC2086
      DISPLAY="$nested" "$CANARY_BIN" sr15 --name "$CANARY_NAME" $json_flag \
        || echo 'WARN: canary SR15 input delivery reported failures' >&2
    else
      echo "WARN: canary SR15 skipped (no window matches $CANARY_NAME)" >&2
    fi
  fi
  # J6 extended probes: sample geometry, stacking query, root screenshot.
  # shellcheck disable=SC2086
  DISPLAY="$nested" "$CANARY_BIN" root-geometry $json_flag 2>/dev/null \
    || echo 'WARN: canary root-geometry probe failed' >&2
  # shellcheck disable=SC2086
  DISPLAY="$nested" "$CANARY_BIN" stacking $json_flag 2>/dev/null \
    || echo 'WARN: canary stacking probe failed' >&2
  # shellcheck disable=SC2086
  DISPLAY="$nested" "$CANARY_BIN" root-shot $json_flag 2>/dev/null \
    || echo 'WARN: canary root-shot probe failed' >&2
  shot="$OUTPUT_DIR/canary-root.png"
  if command -v import >/dev/null 2>&1; then
    DISPLAY="$nested" import -window root "$shot" 2>/dev/null || fail "canary screenshot failed (import)"
    [[ -s "$shot" ]] || fail "canary screenshot failed (empty file)"
    size="$(wc -c <"$shot" | tr -d ' ')"
    [[ "$size" -gt 8192 ]] || fail "canary screenshot rejected (suspiciously small: ${size}B, likely black frame)"
    if command -v identify >/dev/null 2>&1; then
      mean="$(identify -format '%[mean]' "$shot" 2>/dev/null || echo '')"
      echo "canary: screenshot ${size}B mean=${mean:-unknown}"
      if [[ "$mean" == "0" ]]; then
        fail "canary screenshot rejected (all-black frame, mean=0)"
      fi
    else
      echo "canary: screenshot ${size}B (mean check skipped, identify missing)"
    fi
  elif command -v xwd >/dev/null 2>&1; then
    DISPLAY="$nested" xwd -root -out "$OUTPUT_DIR/canary-root.xwd" 2>/dev/null || fail "canary screenshot failed (xwd)"
    size="$(wc -c <"$OUTPUT_DIR/canary-root.xwd" | tr -d ' ')"
    [[ "$size" -gt 8192 ]] || fail "canary screenshot rejected (suspiciously small: ${size}B, likely black frame)"
    echo "canary: xwd dump ${size}B"
  else
    echo 'WARN: canary screenshot skipped (need import or xwd)' >&2
  fi
}

if [[ "$CANARY" == 1 ]]; then
  echo "CANARY mode: bounded run ${CANARY_SECS}s on $nested"
  sleep "$CANARY_SECS"
  if [[ "$SESSION_MODE" == 1 ]]; then require_alive session "$session_pid" "$session_log"; else
    require_alive wm "$wm_pid" "$wm_log"
    require_alive desktop "$desktop_pid" "$desktop_log"
    require_alive shell "$shell_pid" "$shell_log"
  fi
  canary_checks
  if [[ "$SESSION_MODE" == 1 ]]; then require_alive session "$session_pid" "$session_log"; else
    require_alive wm "$wm_pid" "$wm_log"
    require_alive desktop "$desktop_pid" "$desktop_log"
    require_alive shell "$shell_pid" "$shell_log"
  fi
  collect_evidence
  echo "FLAMEWM_XEPHYR_CANARY_PASS display=$nested version=$VERSION"
  echo "logs: $xephyr_log $wm_log $desktop_log $shell_log $session_log"
  echo "evidence: $RUN_DIR"
  exit 0
fi

if [[ "$SESSION_MODE" == 1 ]]; then
  echo "FlameWM $VERSION running on $nested (flamewm-session supervisor)"
else
  echo "FlameWM $VERSION running on $nested (wm -> desktop -> shell)"
fi
echo "logs: $xephyr_log $wm_log $desktop_log $shell_log $session_log"
# Supervise: fail visibly if any required child exits. Fail-fast is preserved:
# no `|| true` masks on the required children, and now the FIRST dead child is
# classified (pid/name/status/signal) so a child segfault is never mislabeled as
# the later, expected `X connection broken` that follows Xephyr teardown.
while true; do
  if [[ "$SESSION_MODE" == 1 ]]; then supervised_pids=("$xephyr_pid" "$session_pid"); else supervised_pids=("$xephyr_pid" "$wm_pid" "$desktop_pid" "$shell_pid"); fi
  if ! wait -n "${supervised_pids[@]}" 2>/dev/null; then
    : # reaped child failed; classification below does not hide the failure
  fi
  # wait -n reaped one exited child; classify exactly which one (never masked).
  if first_dead_child; then
    fail "first-dead-child reported above (see logs)"
  fi
done
