#!/usr/bin/env bash
# Wrapper for the isolated native icon theme install acceptance runner (TI01..TI06).
# Usage: scripts/theme-install-acceptance --run-dir DIR [runner options]
# Runs tools/flamewm_theme_install_acceptance.py and prints the result.json path.
set -euo pipefail

usage() {
  cat <<'EOF'
Usage: scripts/theme-install-acceptance --run-dir DIR [--geometry WxH] [--display :N]
       [--wm-bin PATH] [--shell-bin PATH] [--settings-bin PATH] [--settle-seconds S]

Runs the isolated icon theme install acceptance (TI01..TI06) in a private Xephyr,
a private D-Bus session and private XDG directories under DIR. Installs a folder
and a .tar.gz theme through the Settings Install buttons with a private fake
FileChooser portal, checks the picker and iconTheme, and checks that an escaping
symlink folder and a corrupt archive are rejected. DIR must not exist or be empty.
Writes DIR/result.json and DIR/shots/*.png. Default binaries are the release
artifacts under .target/release/.
EOF
}

if [[ "$#" -eq 1 && ( "$1" == "--help" || "$1" == "-h" ) ]]; then
  usage
  exit 0
fi
if [[ "$#" -eq 0 ]]; then
  usage >&2
  exit 2
fi

ROOT="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd -P)"
if [[ ! -f "$ROOT/Cargo.toml" ]]; then
  echo "error: $ROOT does not contain Cargo.toml; refusing to run" >&2
  exit 2
fi

RUNNER="$ROOT/tools/flamewm_theme_install_acceptance.py"
if [[ ! -f "$RUNNER" ]]; then
  echo "error: runner missing: $RUNNER" >&2
  exit 2
fi

rc=0
output="$(python3 -I "$RUNNER" "$@")" || rc=$?
printf '%s\n' "$output"
result_path="$(printf '%s\n' "$output" | tail -n 1)"
echo "result.json: $result_path"
exit "$rc"
