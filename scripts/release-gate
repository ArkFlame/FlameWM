#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd -P)"
cd "$ROOT"

fail() {
    printf 'ERROR release gate: %s\n' "$1" >&2
    exit 1
}

version="$(./scripts/version)"
[[ -n "$version" ]] || fail 'workspace version is empty'
printf 'RELEASE_GATE %s\n' "$version"
printf '%s\n' 'GATE native checks: ./scripts/check'
./scripts/check

grep -Fqx "version = \"$version\"" Cargo.toml \
    || fail "workspace package version must be $version"
printf 'OK metadata: workspace version is %s\n' "$version"

printf '%s\n' 'GATE package assembly: ./scripts/package'
./scripts/package

dist="$ROOT/.target/dist"
checksums="$dist/SHA256SUMS"
[[ -s "$checksums" ]] || fail "missing package checksum manifest: $checksums"
(cd "$dist" && sha256sum -c SHA256SUMS >/dev/null) \
    || fail 'package checksum proof failed'

while IFS='  ' read -r checksum artifact; do
    [[ -n "$artifact" ]] || fail 'package checksum manifest contains an empty artifact'
    case "$artifact" in
        "flamewm-$version-source.tar.gz"|"flamewm-$version-linux-x86_64.tar.gz"|"flamewm_${version}_amd64.deb") ;;
        *) fail "unexpected package artifact or version: $artifact" ;;
    esac
done < "$checksums"

printf 'OK package: %s artifacts and SHA256SUMS verified\n' "$version"

deb="$dist/flamewm_${version}_amd64.deb"
deb_status=NOT_RUN
if ! command -v dpkg-deb >/dev/null 2>&1 || ! command -v dpkg >/dev/null 2>&1; then
    printf '%s\n' 'NOT_RUN deb acceptance: dpkg-deb or dpkg not found'
elif [[ ! -f "$deb" ]]; then
    printf 'NOT_RUN deb acceptance: no .deb at %s\n' "$deb"
else
    printf '%s\n' "GATE deb acceptance: python3 -I tools/flamewm_deb_acceptance.py --deb $deb"
    python3 -I "$ROOT/tools/flamewm_deb_acceptance.py" --deb "$deb" \
        || fail 'deb acceptance FAILED or was blocked (see JSON report above)'
    deb_status=PASS
fi

printf '%s\n' 'UNEXECUTED runtime gate: ./scripts/xephyr'
printf '%s\n' 'UNEXECUTED visual gate: ./scripts/verify-visual'
if [[ "$deb_status" == PASS ]]; then
    printf '%s\n' 'RELEASE_GATE PASS: build, metadata, package, and deb acceptance proof'
else
    printf '%s\n' 'RELEASE_GATE PARTIAL: deb acceptance NOT_RUN; build, metadata, and package proof only'
fi
