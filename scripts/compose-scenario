#!/usr/bin/env bash
# One-second ACTIVE-USE composition of the nested compositor: one terminal streaming continuous
# output into its PTY, sampled by the compositor's own once-per-second COMPOSITION dump.
#
# Prints SHARES (which in-thread subsystem owns the active second), never total CPU.
# The busiest one-second tick is the one whose non-wait rows sum highest, so startup ticks cannot
# win. Only genuine one-second windows are considered: the profiler's first report is anchored on
# its default 60 s interval, so its shares are diluted by 60 and are not a usable sample.
#
# A run whose busiest tick still has < 5% non-wait work prints LOAD-NOT-REACHED and exits 3, so an
# idle compositor is never reported as an active-use measurement.
#
# Usage: scripts/compose-scenario [--dry-run] [--help]
# Env:   FLAMEWM_WAYLAND_BIN, FLAMEWM_TERMINAL_BIN, CARGO_TARGET_DIR
# Needs: an existing Wayland or X11 display, XDG_RUNTIME_DIR, timeout, a built compositor + terminal.
# No python, no sleep binary: waiting uses `read -rt` timeouts.
set -Eeuo pipefail

usage() {
  printf '%s\n' 'Usage: scripts/compose-scenario [--dry-run]' \
    'Starts a nested FLAMEWM_PROFILE_COMPOSE=1 compositor, streams one second of terminal output,' \
    'and prints the COMPOSITION block of the busiest tick, naming the largest share.'
}
if [[ "${1:-}" == --help || "${1:-}" == -h ]]; then usage; exit 0; fi
if (( $# > 1 )) || { (( $# == 1 )) && [[ "$1" != --dry-run ]]; }; then
  usage >&2
  exit 2
fi
if [[ -z "${WAYLAND_DISPLAY:-}" && -z "${DISPLAY:-}" ]]; then
  echo 'FLAMEWM-COMPOSE-SCENARIO: no existing Wayland/X11 display; run this on a graphical session.' >&2
  exit 2
fi
if [[ -z "${XDG_RUNTIME_DIR:-}" || ! -d "${XDG_RUNTIME_DIR:-/nonexistent}" ]]; then
  echo 'FLAMEWM-COMPOSE-SCENARIO: XDG_RUNTIME_DIR is unavailable; no compositor launched.' >&2
  exit 2
fi
command -v timeout >/dev/null || { echo 'FLAMEWM-COMPOSE-SCENARIO: timeout utility required' >&2; exit 2; }

ROOT="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd -P)"
TARGET_DIR="${CARGO_TARGET_DIR:-$ROOT/.target}"
[[ "$TARGET_DIR" == /* ]] || TARGET_DIR="$ROOT/$TARGET_DIR"
BIN="${FLAMEWM_WAYLAND_BIN:-$TARGET_DIR/release/flamewm-wayland}"
TERM_BIN="${FLAMEWM_TERMINAL_BIN:-$TARGET_DIR/release/flamewm-terminal}"
[[ -x "$TERM_BIN" ]] || TERM_BIN="$(command -v flamewm-terminal || true)"
SOCKET="wayland-flame-compose-$$"

if [[ "${1:-}" == --dry-run ]]; then
  printf 'FLAMEWM-COMPOSE-SCENARIO: dry-run backend=winit socket=%s compositor=%s terminal=%s window=1000ms\n' \
    "$SOCKET" "$BIN" "${TERM_BIN:-<missing>}"
  exit 0
fi
[[ -x "$BIN" ]] || { echo "FLAMEWM-COMPOSE-SCENARIO: compositor not executable: $BIN (build it first)" >&2; exit 2; }
[[ -n "$TERM_BIN" && -x "$TERM_BIN" ]] || {
  echo 'FLAMEWM-COMPOSE-SCENARIO: no terminal client (set FLAMEWM_TERMINAL_BIN)' >&2
  exit 2
}

CACHE="${XDG_CACHE_HOME:-${HOME:?}/.cache}/flamewm"
umask 077
mkdir -p "$CACHE"
LOG="$(mktemp "$CACHE/compose-scenario-XXXXXXXX.log")"
CLIENT_LOG="${LOG%.log}.client.log"
# Sleep-free pause: a FIFO opened read-write never reaches EOF, so `read -rt SECS -u 9` blocks for
# exactly the timeout. Pipes (`<(:)`) hit EOF instantly and would spin the poll loops.
WAIT_FIFO="${LOG%.log}.wait"
mkfifo "$WAIT_FIFO"
exec 9<>"$WAIT_FIFO"
pause() { read -rt "${1:-0.1}" -u 9 || true; }
SOCK_PATH="$XDG_RUNTIME_DIR/$SOCKET"
comp_pid=''
client_pid=''

cleanup() {
  local pid alive
  for pid in "$client_pid" "$comp_pid"; do
    [[ -n "$pid" ]] || continue
    kill -TERM "$pid" 2>/dev/null || true
  done
  # Bounded reap: `wait` alone could hang on a compositor that ignores TERM. `pause` is the
  # sleep-free delay and also the loop bound.
  for _ in {1..40}; do
    alive=0
    for pid in "$client_pid" "$comp_pid"; do
      [[ -n "$pid" ]] && kill -0 "$pid" 2>/dev/null && alive=1
    done
    (( alive )) || break
    pause 0.05
  done
  for pid in "$client_pid" "$comp_pid"; do
    [[ -n "$pid" ]] && kill -KILL "$pid" 2>/dev/null || true
  done
  wait 2>/dev/null || true
  exec 9>&- 2>/dev/null || true
  rm -f "$WAIT_FIFO"
}
trap cleanup EXIT

printf 'FLAMEWM-COMPOSE-SCENARIO: launching nested winit compositor; log=%s\n' "$LOG"
FLAMEWM_WAYLAND_BACKEND=winit FLAMEWM_WAYLAND_SOCKET="$SOCKET" FLAMEWM_WAYLAND_AUTOSTART='' \
  FLAMEWM_PROFILE_COMPOSE=1 RUST_BACKTRACE=1 \
  timeout --signal=TERM --kill-after=2s 20s "$BIN" >"$LOG" 2>&1 &
comp_pid=$!

# Wait for the compositor's Wayland socket; no sleep binary, `read -rt` paces the poll.
for _ in {1..200}; do
  [[ -S "$SOCK_PATH" ]] && break
  kill -0 "$comp_pid" 2>/dev/null || break
  pause 0.05
done
if [[ ! -S "$SOCK_PATH" ]]; then
  echo "FLAMEWM-COMPOSE-SCENARIO: compositor socket never appeared: $SOCK_PATH" >&2
  tail -n 20 "$LOG" >&2 || true
  exit 1
fi

# FlameWM's own apps (the terminal included) are X11 clients, so the scenario must point them at
# this compositor's XWayland display, not the host's. The compositor logs the display it got.
CLIENT_DISPLAY=''
for _ in {1..100}; do
  CLIENT_DISPLAY="$(sed -n 's/.*XWayland ready on DISPLAY=\(:[0-9][0-9]*\).*/\1/p' "$LOG" | tail -n 1)"
  [[ -n "$CLIENT_DISPLAY" ]] && break
  kill -0 "$comp_pid" 2>/dev/null || break
  pause 0.05
done
if [[ -z "$CLIENT_DISPLAY" ]]; then
  echo 'FLAMEWM-COMPOSE-SCENARIO: nested XWayland never became ready; the X11 terminal cannot attach' >&2
  tail -n 20 "$LOG" >&2 || true
  exit 1
fi

# One terminal client streaming into its PTY until killed: 2000-line bursts (`yes | head -n 2000`)
# repeated forever. Whole-line bursts exercise the terminal's dirty-line path and leave a short gap
# between bursts for the UI to commit frames; a single unbounded `yes` kept the PTY permanently
# readable and the client rendered almost nothing. The feed runs in the client process, so its CPU
# never enters the compositor's own shares.
FEED='while :; do yes | head -n 2000; done'
WAYLAND_DISPLAY="$SOCKET" DISPLAY="$CLIENT_DISPLAY" timeout --signal=TERM --kill-after=1s 10s \
  "$TERM_BIN" -e bash -c "$FEED" >/dev/null 2>"$CLIENT_LOG" &
client_pid=$!

# Wait until the client has finished its render-backend startup (those lines are logged once, before
# the window loop), so the sampled ticks measure terminal paint work, not compositor bring-up.
for _ in {1..100}; do
  grep -q '^FLAMEWM_RENDER_TEXT_BACKEND' "$CLIENT_LOG" 2>/dev/null && break
  kill -0 "$client_pid" 2>/dev/null || break
  pause 0.05
done
# Warm-up: map the window and land its first frame outside the measured ticks.
pause 1.0
# Two full one-second ticks with continuous PTY output in flight.
pause 2.2

kill -TERM "$client_pid" 2>/dev/null || true
client_pid=''
# One more tick boundary so the active window is flushed to the log.
pause 1.2
kill -TERM "$comp_pid" 2>/dev/null || true

block="$(awk '
  function eligible(t) { return (t in waitshare) && (waitwall[t] + 0 <= 2000) }
  function flush() {
    if (n > 0 && cur != "" && eligible(cur) && (!bestset || sum[cur] > sum[best] + 0.0001)) {
      best = cur
      bestset = 1
    }
  }
  /^FLAMEWM-WAYLAND-COMPOSE tick=/ {
    flush()
    n++
    cur = n
    if ($0 ~ /share=wait:100\.0/) {
      # A fully parked tick prints one line: no COMPOSITION block, zero active work.
      sum[cur] = 0
      waitshare[cur] = "100.0"
      waitwall[cur] = 0
    }
    next
  }
  /^COMPOSITION:$/ { incomp = 1; next }
  incomp && /^ / {
    label = $1
    share = $2
    sub(/^share=/, "", share)
    sub(/%$/, "", share)
    if (label == "wait") {
      waitshare[cur] = share
      wallv = $3
      sub(/^wall=/, "", wallv)
      sub(/ms$/, "", wallv)
      waitwall[cur] = wallv
      incomp = 0
    } else {
      sum[cur] += share
      rows[cur] = rows[cur] label " share=" share "\n"
    }
    next
  }
  incomp && NF { incomp = 0 }
  END {
    flush()
    if (!bestset) { print "NO_TICK"; exit }
    printf "%s", rows[best]
    if (best in waitshare) printf "wait share=%s\n", waitshare[best]
  }
' "$LOG")"

if [[ "$block" == NO_TICK || -z "$block" ]]; then
  # Either the compositor died before one full one-second window, or every tick was parked with no
  # COMPOSITION block: no active second was measured, so this must not be reported as a run.
  echo 'FLAMEWM-COMPOSE-SCENARIO: LOAD-NOT-REACHED no one-second COMPOSITION tick captured (compositor did not stay up?)' >&2
  tail -n 20 "$LOG" >&2 || true
  exit 3
fi

largest="$(printf '%s\n' "$block" | awk 'NF && $1 != "wait" { print; exit }')"
printf 'FLAMEWM-COMPOSE-SCENARIO: scenario=terminal-1s log=%s client_log=%s\n' "$LOG" "$CLIENT_LOG"
printf 'FLAMEWM-COMPOSE-SCENARIO: shares (percent of the sampled second, self wall):\n'
printf '%s\n' "$block" | sed 's/^ */  /'
printf 'FLAMEWM-COMPOSE-SCENARIO: largest share: %s (drive this first)\n' "$largest"
active="$(printf '%s\n' "$block" | awk 'NF && $1 != "wait" {
    v = $2; sub(/^share=/, "", v); sub(/%$/, "", v); s += v
  } END { printf "%.1f", s }')"
if awk -v s="$active" 'BEGIN { exit !(s + 0 < 5.0) }'; then
  printf 'FLAMEWM-COMPOSE-SCENARIO: LOAD-NOT-REACHED busiest tick active share=%s%% < 5%% (terminal never painted; check client_log=%s)\n' \
    "$active" "$CLIENT_LOG" >&2
  tail -n 20 "$CLIENT_LOG" >&2 || true
  exit 3
fi
