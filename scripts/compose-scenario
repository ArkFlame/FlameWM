#!/usr/bin/env bash
# One-second ACTIVE-USE composition of the nested compositor: one terminal streaming 2000-line
# bursts into its PTY, sampled by the compositor's own once-per-second COMPOSITION dump.
#
# Prints SHARES (which in-thread subsystem owns the active second), never total CPU. The busiest
# one-second tick is the one whose non-wait rows sum highest, so startup ticks cannot win.
#
# Usage: scripts/compose-scenario [--dry-run] [--help]
# Env:   FLAMEWM_WAYLAND_BIN, FLAMEWM_TERMINAL_BIN, CARGO_TARGET_DIR
# Needs: an existing Wayland or X11 display, XDG_RUNTIME_DIR, timeout, a built compositor + terminal.
# No python, no sleep binary: waiting uses `read -rt` timeouts.
set -Eeuo pipefail

usage() {
  printf '%s\n' 'Usage: scripts/compose-scenario [--dry-run]' \
    'Starts a nested FLAMEWM_PROFILE_COMPOSE=1 compositor, streams one second of terminal output,' \
    'and prints the COMPOSITION block of the busiest tick, naming the largest share.'
}
if [[ "${1:-}" == --help || "${1:-}" == -h ]]; then usage; exit 0; fi
if (( $# > 1 )) || { (( $# == 1 )) && [[ "$1" != --dry-run ]]; }; then
  usage >&2
  exit 2
fi
if [[ -z "${WAYLAND_DISPLAY:-}" && -z "${DISPLAY:-}" ]]; then
  echo 'FLAMEWM-COMPOSE-SCENARIO: no existing Wayland/X11 display; run this on a graphical session.' >&2
  exit 2
fi
if [[ -z "${XDG_RUNTIME_DIR:-}" || ! -d "${XDG_RUNTIME_DIR:-/nonexistent}" ]]; then
  echo 'FLAMEWM-COMPOSE-SCENARIO: XDG_RUNTIME_DIR is unavailable; no compositor launched.' >&2
  exit 2
fi
command -v timeout >/dev/null || { echo 'FLAMEWM-COMPOSE-SCENARIO: timeout utility required' >&2; exit 2; }

ROOT="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd -P)"
TARGET_DIR="${CARGO_TARGET_DIR:-$ROOT/.target}"
[[ "$TARGET_DIR" == /* ]] || TARGET_DIR="$ROOT/$TARGET_DIR"
BIN="${FLAMEWM_WAYLAND_BIN:-$TARGET_DIR/release/flamewm-wayland}"
TERM_BIN="${FLAMEWM_TERMINAL_BIN:-$TARGET_DIR/release/flamewm-terminal}"
[[ -x "$TERM_BIN" ]] || TERM_BIN="$(command -v flamewm-terminal || true)"
SOCKET="wayland-flame-compose-$$"

if [[ "${1:-}" == --dry-run ]]; then
  printf 'FLAMEWM-COMPOSE-SCENARIO: dry-run backend=winit socket=%s compositor=%s terminal=%s window=1000ms\n' \
    "$SOCKET" "$BIN" "${TERM_BIN:-<missing>}"
  exit 0
fi
[[ -x "$BIN" ]] || { echo "FLAMEWM-COMPOSE-SCENARIO: compositor not executable: $BIN (build it first)" >&2; exit 2; }
[[ -n "$TERM_BIN" && -x "$TERM_BIN" ]] || {
  echo 'FLAMEWM-COMPOSE-SCENARIO: no terminal client (set FLAMEWM_TERMINAL_BIN)' >&2
  exit 2
}

CACHE="${XDG_CACHE_HOME:-${HOME:?}/.cache}/flamewm"
umask 077
mkdir -p "$CACHE"
LOG="$(mktemp "$CACHE/compose-scenario-XXXXXXXX.log")"
CLIENT_LOG="${LOG%.log}.client.log"
SOCK_PATH="$XDG_RUNTIME_DIR/$SOCKET"
comp_pid=''
client_pid=''

cleanup() {
  local pid alive
  for pid in "$client_pid" "$comp_pid"; do
    [[ -n "$pid" ]] || continue
    kill -TERM "$pid" 2>/dev/null || true
  done
  # Bounded reap: `wait` alone could hang on a compositor that ignores TERM. `read -rt` is the
  # sleep-free delay and also the loop bound.
  for _ in {1..40}; do
    alive=0
    for pid in "$client_pid" "$comp_pid"; do
      [[ -n "$pid" ]] && kill -0 "$pid" 2>/dev/null && alive=1
    done
    (( alive )) || break
    read -rt 0.05 <> <(:) || true
  done
  for pid in "$client_pid" "$comp_pid"; do
    [[ -n "$pid" ]] && kill -KILL "$pid" 2>/dev/null || true
  done
  wait 2>/dev/null || true
}
trap cleanup EXIT

printf 'FLAMEWM-COMPOSE-SCENARIO: launching nested winit compositor; log=%s\n' "$LOG"
FLAMEWM_WAYLAND_BACKEND=winit FLAMEWM_WAYLAND_SOCKET="$SOCKET" FLAMEWM_WAYLAND_AUTOSTART='' \
  FLAMEWM_PROFILE_COMPOSE=1 RUST_BACKTRACE=1 \
  timeout --signal=TERM --kill-after=2s 20s "$BIN" >"$LOG" 2>&1 &
comp_pid=$!

# Wait for the compositor's Wayland socket; no sleep binary, `read -rt` paces the poll.
for _ in {1..200}; do
  [[ -S "$SOCK_PATH" ]] && break
  kill -0 "$comp_pid" 2>/dev/null || break
  read -rt 0.05 <> <(:) || true
done
if [[ ! -S "$SOCK_PATH" ]]; then
  echo "FLAMEWM-COMPOSE-SCENARIO: compositor socket never appeared: $SOCK_PATH" >&2
  tail -n 20 "$LOG" >&2 || true
  exit 1
fi

# One terminal client, one second of output into its PTY: 2000-line bursts (`yes | head -n 2000`)
# until the SECONDS clock passes the start second. Bursts keep the PTY continuously readable and
# land in whole lines so the terminal exercises its dirty-line path, not a partial-line redraw.
FEED='end=$((SECONDS+1)); while (( SECONDS < end )); do yes | head -n 2000; done'
WAYLAND_DISPLAY="$SOCKET" timeout --signal=TERM --kill-after=1s 10s \
  "$TERM_BIN" -e bash -c "$FEED" >/dev/null 2>"$CLIENT_LOG" &
client_pid=$!

# Cover the streaming second plus the tick that reports it (the dump is once per second).
read -rt 2.2 <> <(:) || true

kill -TERM "$client_pid" 2>/dev/null || true
client_pid=''
# One more tick boundary so the active window is flushed to the log.
read -rt 1.2 <> <(:) || true
kill -TERM "$comp_pid" 2>/dev/null || true

block="$(awk '
  function flush() {
    if (n > 0 && cur != "" && sum[cur] > sum[best] + 0.0001) best = cur
  }
  /^FLAMEWM-WAYLAND-COMPOSE tick=/ {
    flush()
    n++
    cur = n
    if (n == 1) best = 1
    incomp = 0
    next
  }
  /^COMPOSITION:$/ { incomp = 1; next }
  incomp && /^ / {
    label = $1
    share = $2
    sub(/^share=/, "", share)
    sub(/%$/, "", share)
    if (label == "wait") {
      waitshare[cur] = share
      incomp = 0
    } else {
      sum[cur] += share
      rows[cur] = rows[cur] label " share=" share "\n"
    }
    next
  }
  incomp && NF { incomp = 0 }
  END {
    flush()
    printf "%s", rows[best]
    if (best in waitshare) printf "wait share=%s\n", waitshare[best]
  }
' "$LOG")"

if [[ -z "$block" ]]; then
  echo 'FLAMEWM-COMPOSE-SCENARIO: no COMPOSITION tick captured (compositor did not stay up?)' >&2
  tail -n 20 "$LOG" >&2 || true
  exit 1
fi

largest="$(printf '%s\n' "$block" | awk 'NF && $1 != "wait" { print; exit }')"
printf 'FLAMEWM-COMPOSE-SCENARIO: scenario=terminal-1s log=%s client_log=%s\n' "$LOG" "$CLIENT_LOG"
printf 'FLAMEWM-COMPOSE-SCENARIO: shares (percent of the sampled second, self wall):\n'
printf '%s\n' "$block" | sed 's/^ */  /'
printf 'FLAMEWM-COMPOSE-SCENARIO: largest share: %s (drive this first)\n' "$largest"
if ! printf '%s\n' "$block" | awk 'NF && $1 != "wait" {
    v = $2; sub(/^share=/, "", v); sub(/%$/, "", v)
    if (v + 0 > 0.05) seen = 1
  } END { exit !seen }'; then
  echo 'FLAMEWM-COMPOSE-SCENARIO: WARN no subsystem above 0.05%: the client likely never painted (check client_log)' >&2
fi
