#!/usr/bin/env bash
# Fault-injection test for the session wrapper preflight and last-resort minimal mode.
#
# The real preflight_libs, run_minimal_mode and run_safe_mode functions are extracted from
# scripts/flamewm-session-wrapper and sourced into this process; the wrapper's main tail is never
# executed. ldd is shadowed on a sandbox-prefixed PATH so it prints a controlled, fake result for a
# fake, executable binary. No real ldd, session, compositor, cargo build or network access is used.
#
# Cases:
#   1. ldd prints 'libfoo.so.1 => not found': preflight_libs returns non-zero and a failure record
#      naming libfoo.so.1 is written to the session log.
#   2. ldd prints every NEEDED library resolved: preflight_libs returns 0 and writes nothing.
#   3. safe mode finds a WM but no shell/xmessage: minimal mode reuses that WM and records it.
#   4. minimal mode finds no display or WM: it records the failure and returns non-zero.
#   5. Missing Wayland client library is classified as a nested_wayland degradation with x11 works.
#   6. Missing GPU (EGL) library is classified as wayland_gpu_renderer with x11 works.
#   7. Unset DISPLAY makes chain_cause report +no_display on the session_preflight cause.
#   8. Exit codes 127 and 126 map to binary_missing and binary_not_executable.
#   9. Bad XDG_RUNTIME_DIR, a fatal log and a DEGRADED log append the matching cause suffixes.
#
# Usage: bash scripts/test-wrapper-faults
# Exit: 0 when every case passes, 1 otherwise. Prints PASS/FAIL per case plus a SUMMARY line.
set -uo pipefail

SELF_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
ROOT=$(cd -- "$SELF_DIR/.." && pwd)
WRAPPER="$ROOT/scripts/flamewm-session-wrapper"

BASE=$(mktemp -d "${TMPDIR:-/tmp}/flamewm-wrapper-faults.XXXXXX") || exit 1
cleanup() { rm -rf "$BASE"; }
trap cleanup EXIT

BIN="$BASE/bin"
STATE="$BASE/state"
mkdir -p "$BIN" "$STATE" || exit 1

# A fake, executable binary: ldd is shadowed, so its contents are never really inspected.
printf '#!/bin/sh\nexit 0\n' >"$BIN/fake-app"
chmod 700 "$BIN/fake-app"

# Extract the real preflight functions from the wrapper without running its main tail. The block is
# contiguous: session_preflight_blast, session_preflight_record and preflight_libs. Stop at the
# closing brace of preflight_libs rather than at a hard-coded line number.
EXTRACTED="$BASE/preflight.inc"
awk '
    /^session_preflight_blast\(\)/ { on=1 }
    on { print }
    on && /^preflight_libs\(\)/ { in_pl=1 }
    in_pl && /^}/ { exit }
' "$WRAPPER" >"$EXTRACTED" || exit 1
if ! grep -qF 'preflight_libs()' "$EXTRACTED"; then
    printf 'FAIL setup: could not extract preflight_libs from %s\n' "$WRAPPER"
    exit 1
fi

# The last-resort minimal-mode helper is a separate function; extract it verbatim too.
MINIMAL="$BASE/minimal.inc"
awk '
    /^run_minimal_mode\(\)/ { on=1 }
    on { print }
    on && /^}/ { exit }
' "$WRAPPER" >"$MINIMAL" || exit 1
if ! grep -qF 'run_minimal_mode()' "$MINIMAL"; then
    printf 'FAIL setup: could not extract run_minimal_mode from %s\n' "$WRAPPER"
    exit 1
fi

# run_safe_mode is the caller that hands a failed shell/desktop handoff to minimal mode.
SAFE="$BASE/safe.inc"
awk '
    /^run_safe_mode\(\)/ { on=1 }
    on { print }
    on && /^}/ { exit }
' "$WRAPPER" >"$SAFE" || exit 1
if ! grep -qF 'run_safe_mode()' "$SAFE"; then
    printf 'FAIL setup: could not extract run_safe_mode from %s\n' "$WRAPPER"
    exit 1
fi

# chain_cause maps exit codes and environment faults to a causal label. Extract it so the no-X,
# missing-binary and bad-environment fallbacks can be asserted without running the wrapper tail.
CAUSE="$BASE/cause.inc"
awk '
    /^chain_cause\(\)/ { on=1 }
    on { print }
    on && /^}/ { exit }
' "$WRAPPER" >"$CAUSE" || exit 1
if ! grep -qF 'chain_cause()' "$CAUSE"; then
    printf 'FAIL setup: could not extract chain_cause from %s\n' "$WRAPPER"
    exit 1
fi

# Mechanical helpers the extracted functions call. They carry no behavior under test: timing is
# pinned and blast-radius labels are fixed tokens.
CHAIN_START_MS=0
chain_now_ms() { printf '0'; }
chain_ms() { printf '0'; }
chain_works() { case "$1" in
    x11|minimal) printf 'x_server+x11_clients' ;;
    safe) printf 'shell+diagnostics' ;;
    *) printf 'unknown' ;;
esac; }
chain_degraded() { case "$1" in
    x11) printf 'wayland_native+compositor+kms_presentation' ;;
    safe) printf 'gui+shell+desktop+compositor' ;;
    minimal) printf 'shell+desktop+compositor' ;;
    *) printf 'unknown_component' ;;
esac; }
MINIMAL_RECORD="$BASE/minimal-record.log"
# Mirror the wrapper's chain_record field layout so the minimal-mode records can be asserted on.
chain_record() { # stage status cause code works degraded [extra]
    local line="FLAMEWM-SESSION-CHAIN stage=$1 status=$2 cause=$3 code=$4 blast_radius=works:$5|degraded:$6 ms=$(chain_ms)"
    [[ -n "${7:-}" ]] && line+=" detail=$7"
    printf '%s\n' "$line" >>"$MINIMAL_RECORD"
}

CHAIN_LOG="$BASE/chain.log"
export XDG_STATE_HOME="$STATE"
LOG="$STATE/flamewm/session.log"

# shellcheck source=/dev/null
source "$EXTRACTED" || exit 1
# shellcheck source=/dev/null
source "$MINIMAL" || exit 1
# shellcheck source=/dev/null
source "$SAFE" || exit 1
# shellcheck source=/dev/null
source "$CAUSE" || exit 1

# Shadow ldd: it prints the preset FAKE_LDD_OUT file regardless of the binary argument.
cat >"$BIN/ldd" <<'EOF'
#!/bin/sh
cat "${FAKE_LDD_OUT:?}"
EOF
chmod 700 "$BIN/ldd"
export PATH="$BIN:$PATH"

CASES=0
FAILED_CASES=0
CASE_NAME=""
CASE_FAILS=0
RC=0

start_case() {
    CASE_NAME="$1"
    CASE_FAILS=0
    CASES=$((CASES + 1))
    printf 'CASE %s\n' "$CASE_NAME"
}
assert_case() { # description command [args...]
    local desc="$1"
    shift
    if "$@"; then
        printf '  ok   %s\n' "$desc"
    else
        printf '  FAIL %s\n' "$desc"
        CASE_FAILS=$((CASE_FAILS + 1))
    fi
}
end_case() {
    if (( CASE_FAILS == 0 )); then
        printf 'PASS %s\n' "$CASE_NAME"
    else
        printf 'FAIL %s\n' "$CASE_NAME"
        FAILED_CASES=$((FAILED_CASES + 1))
    fi
}

nonzero_rc() { (( RC != 0 )); }
zero_rc() { (( RC == 0 )); }
record_names_lib() { # log-file
    grep -aEq 'FLAMEWM-SESSION-CHAIN stage=preflight status=fail cause=missing_lib .*detail=lib=libfoo\.so\.1' "$1"
}
no_log_write() { # log-file
    [[ ! -s "$1" ]];
}
marker_exists() { [[ -f "$1" ]]; }
no_marker() { [[ ! -e "$1" ]]; }
minimal_ok_record() { # record-file
    grep -aqF 'minimal ok shell_desktop_failed 0' "$1" \
        && grep -aqE 'wm_pid=[0-9]+' "$1"
}
minimal_fail_record() { # record-file
    grep -aqF 'minimal fail no_wm 1' "$1" \
        && grep -aqF 'no_display_or_wm' "$1"
}

# Case 1: one unresolved NEEDED library.
start_case missing-library
MISSING_OUT="$BASE/ldd-missing.txt"
printf '%s\n' 'libfoo.so.1 => not found' >"$MISSING_OUT"
export FAKE_LDD_OUT="$MISSING_OUT"
rm -f "$LOG"
preflight_libs "$BIN/fake-app" >"$BASE/case1.out" 2>"$BASE/case1.err"
RC=$?
assert_case "non-zero return when a NEEDED library is unresolved" nonzero_rc
assert_case "failure record naming libfoo.so.1 in session.log" record_names_lib "$LOG"
end_case

# Case 2: every NEEDED library resolves.
start_case all-resolved
RESOLVED_OUT="$BASE/ldd-resolved.txt"
cat >"$RESOLVED_OUT" <<'EOF'
	linux-vdso.so.1 (0x00007ffd00000000)
	libfoo.so.1 => /usr/lib/libfoo.so.1 (0x00007f0000000000)
	libc.so.6 => /usr/lib/libc.so.6 (0x00007f0001000000)
EOF
export FAKE_LDD_OUT="$RESOLVED_OUT"
rm -f "$LOG"
preflight_libs "$BIN/fake-app" >"$BASE/case2.out" 2>"$BASE/case2.err"
RC=$?
assert_case "zero return when all NEEDED libraries resolve" zero_rc
assert_case "no session log entry written" no_log_write "$LOG"
end_case

minimal_record_has() {
    grep -aEq 'stage=minimal status=ok cause=shell_desktop_failed code=0 blast_radius=works:[^[:space:]|]+\|degraded:[^[:space:]|]+' "$MINIMAL_RECORD"
}

# Case 3: last-resort minimal mode with a WM available: only the WM is started and waited on.
start_case minimal-wm-only
WM_MARKER="$BASE/minimal-wm.marker"
cat >"$BIN/fake-wm" <<'WM_EOF'
#!/bin/sh
printf 'minimal-wm\n' >>"${WM_MARKER_LOG:?}"
: >"${WM_MARKER:?}"
exit 0
WM_EOF
chmod 700 "$BIN/fake-wm"
export FLAMEWM_SAFE_WM="$BIN/fake-wm"
export DISPLAY=:99
export WM_MARKER_LOG="$BASE/minimal-wm.log" WM_MARKER="$WM_MARKER"
rm -f "$WM_MARKER" "$MINIMAL_RECORD"
run_minimal_mode >"$BASE/case3.out" 2>"$BASE/case3.err"
RC=$?
assert_case "minimal mode returns 0 with a usable WM" zero_rc
assert_case "minimal mode started the WM" test -f "$WM_MARKER"
assert_case "minimal mode record has stage/cause/blast radius" minimal_record_has
end_case

# Case 4: no shell, no desktop and no WM: minimal mode reports failure instead of hanging.
start_case minimal-no-wm
rm -f "$MINIMAL_RECORD"
(
    export PATH="$BIN"
    export FLAMEWM_SAFE_WM="no-such-wm"
    run_minimal_mode
) >"$BASE/case4.out" 2>"$BASE/case4.err"
RC=$?
assert_case "minimal mode returns non-zero with no WM" nonzero_rc
assert_case "minimal mode failure record present" grep -aqF 'stage=minimal status=fail' "$MINIMAL_RECORD"
end_case

# Cases 5-9 cover the fallbacks named in the wrapper contract: no Wayland backend, no X, no GPU,
# missing binary and bad environment. They use only the extracted helpers; nothing is executed.
start_case no-wayland-backend
WAYLAND_OUT="$BASE/ldd-wayland.txt"
printf '%s\n' 'libwayland-client.so.0 => not found' >"$WAYLAND_OUT"
export FAKE_LDD_OUT="$WAYLAND_OUT"
rm -f "$LOG"
preflight_libs "$BIN/fake-app" >"$BASE/case5.out" 2>"$BASE/case5.err"
RC=$?
assert_case "non-zero return when the Wayland client library is missing" nonzero_rc
assert_case "missing Wayland backend is recorded as nested_wayland" grep -aqF 'degraded=nested_wayland+wayland_lock' "$LOG"
assert_case "x11 clients remain the working fallback" grep -aqF 'works:x_server+x11_clients' "$LOG"
end_case

start_case no-gpu
GPU_OUT="$BASE/ldd-gpu.txt"
printf '%s\n' 'libEGL.so.1 => not found' >"$GPU_OUT"
export FAKE_LDD_OUT="$GPU_OUT"
rm -f "$LOG"
preflight_libs "$BIN/fake-app" >"$BASE/case6.out" 2>"$BASE/case6.err"
RC=$?
assert_case "non-zero return when the GPU library is missing" nonzero_rc
assert_case "missing GPU renderer is recorded as wayland_gpu_renderer" grep -aqF 'degraded=wayland_gpu_renderer+x11_gpu_blur' "$LOG"
assert_case "x11 clients remain the working fallback" grep -aqF 'works:x_server+x11_clients' "$LOG"
end_case

start_case no-x-display
rm -f "$LOG"
(
    unset DISPLAY
    chain_cause x11 1
) >"$BASE/case7.out" 2>"$BASE/case7.err"
assert_case "rc=1 maps to session_preflight" grep -aqE '^session_preflight' "$BASE/case7.out"
assert_case "unset DISPLAY appends +no_display" grep -aqF '+no_display' "$BASE/case7.out"
end_case

start_case missing-binary
rm -f "$LOG"
(
    export DISPLAY=:99
    unset XDG_RUNTIME_DIR
    chain_cause x11 127
) >"$BASE/case8a.out" 2>"$BASE/case8.err"
(
    export DISPLAY=:99
    unset XDG_RUNTIME_DIR
    chain_cause x11 126
) >"$BASE/case8b.out" 2>>"$BASE/case8.err"
assert_case "rc=127 maps to binary_missing" grep -aqFx 'binary_missing' "$BASE/case8a.out"
assert_case "rc=126 maps to binary_not_executable" grep -aqFx 'binary_not_executable' "$BASE/case8b.out"
end_case

start_case bad-env
rm -f "$LOG"
(
    export DISPLAY=:99
    export XDG_RUNTIME_DIR="$BASE/no-such-runtime-dir"
    chain_cause x11 1
) >"$BASE/case9a.out" 2>"$BASE/case9.err"
assert_case "bad XDG_RUNTIME_DIR appends +runtime_dir" grep -aqF '+runtime_dir' "$BASE/case9a.out"
printf 'fatal: preflight aborted\n' >"$LOG"
(
    export DISPLAY=:99
    unset XDG_RUNTIME_DIR
    chain_cause x11 1
) >"$BASE/case9b.out" 2>>"$BASE/case9.err"
assert_case "fatal session log appends +preflight_fatal" grep -aqF '+preflight_fatal' "$BASE/case9b.out"
printf 'DEGRADED components detected\n' >"$LOG"
(
    export DISPLAY=:99
    unset XDG_RUNTIME_DIR
    chain_cause x11 1
) >"$BASE/case9c.out" 2>>"$BASE/case9.err"
assert_case "DEGRADED session log appends +degraded_components" grep -aqF '+degraded_components' "$BASE/case9c.out"
end_case

printf 'SUMMARY cases=%s passed=%s failed=%s\n' \
    "$CASES" "$((CASES - FAILED_CASES))" "$FAILED_CASES"
(( FAILED_CASES == 0 ))
