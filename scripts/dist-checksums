#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd -P)"
DIST="${1:-$ROOT/.target/dist}"

[[ -d "$DIST" ]] || { printf 'FLAMEWM-DIST-ERROR: no distribution directory: %s\n' "$DIST" >&2; exit 1; }
command -v sha256sum >/dev/null 2>&1 || { printf 'FLAMEWM-DIST-ERROR: sha256sum not found\n' >&2; exit 1; }

cd "$DIST"
mapfile -t artifacts < <(find . -maxdepth 1 -type f ! -name SHA256SUMS ! -name '.*' -printf '%f\n' | LC_ALL=C sort)
if (( ${#artifacts[@]} == 0 )); then
    rm -f SHA256SUMS
    printf 'FLAMEWM-DIST: no artifacts in %s\n' "$DIST"
    exit 0
fi
sha256sum -- "${artifacts[@]}" > SHA256SUMS.partial
mv SHA256SUMS.partial SHA256SUMS
printf 'FLAMEWM-DIST: %s artifacts listed in %s/SHA256SUMS\n' "${#artifacts[@]}" "$DIST"
