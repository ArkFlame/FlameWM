#!/usr/bin/env python3
"""Build a deterministic source archive from packaging/source-manifest.txt."""
import gzip
import os
from pathlib import Path, PurePosixPath
import sys
import tarfile
import tempfile


EXCLUDED_DIRS = {".git", ".target", "target", "__pycache__", ".pytest_cache", ".mypy_cache", ".ruff_cache", ".agents", ".debug", ".codex", ".aws", ".performance", "theme-sources"}
EXCLUDED_SUFFIXES = {".pyc", ".pyo", ".swp", ".swo", ".log", ".pem", ".key", ".p12", ".pfx", ".token"}
EXCLUDED_NAMES = {"id_rsa", "id_ed25519", "credentials", "credentials.json", "secrets.json"}


def members(root: Path, manifest: Path) -> list[tuple[Path, str]]:
    found: dict[str, Path] = {}
    executables: set[str] = set()
    absent_trees: list[PurePosixPath] = []
    for raw in manifest.read_text(encoding="utf-8").splitlines():
        entry = raw.strip()
        if not entry or entry.startswith("#"):
            continue
        if entry.startswith("@exec "):
            executable = entry[6:].strip()
            path = PurePosixPath(executable)
            if path.is_absolute() or ".." in path.parts or "\\" in executable or "\x00" in executable:
                raise ValueError(f"unsafe executable registry path: {executable}")
            executables.add(path.as_posix())
            continue
        tree = entry.endswith("/")
        rel = entry.rstrip("/")
        path = PurePosixPath(rel)
        if path.is_absolute() or ".." in path.parts or "\x00" in rel or "\\" in rel:
            raise ValueError(f"unsafe manifest path: {entry}")
        source = root.joinpath(*path.parts)
        if not source.exists() and not source.is_symlink():
            if tree:
                absent_trees.append(path)
            continue
        candidates = source.rglob("*") if tree and source.is_dir() else [source]
        for candidate in candidates:
            relative = candidate.relative_to(root).as_posix()
            parts = PurePosixPath(relative).parts
            if any(part in EXCLUDED_DIRS for part in parts):
                continue
            if candidate.name.lower().startswith(".env") or candidate.name.lower() in EXCLUDED_NAMES or candidate.suffix.lower() in EXCLUDED_SUFFIXES:
                continue
            if candidate.is_symlink():
                target = os.readlink(candidate)
                if PurePosixPath(target).is_absolute() or not (candidate.parent / target).resolve(strict=False).is_relative_to(root):
                    raise ValueError(f"unsafe symlink: {relative} -> {target}")
            found[relative] = candidate
    absent = {name for name in executables - found.keys()
              if not any(PurePosixPath(name).is_relative_to(tree) for tree in absent_trees)}
    if absent:
        raise ValueError(f"registered executable missing from source manifest: {', '.join(sorted(absent))}")
    for relative, source in found.items():
        is_executable = source.is_file() and source.stat().st_mode & 0o111
        if is_executable and relative not in executables:
            raise ValueError(f"executable is not registered: {relative}")
        if relative in executables and not is_executable:
            raise ValueError(f"registered path is not executable: {relative}")
    return [(found[name], name) for name in sorted(found)]


def write_archive(root: Path, manifest: Path, output: Path) -> None:
    root = root.resolve()
    # Validate the *entire* allowlist before opening an output. A missing
    # executable registry entry must never leave a misleading partial .tar.gz.
    entries = members(root, manifest)
    fd, temporary = tempfile.mkstemp(prefix=f".{output.name}.", dir=output.parent)
    try:
        with os.fdopen(fd, "wb") as raw, gzip.GzipFile(filename="", mode="wb", fileobj=raw, mtime=0) as zipped:
            with tarfile.open(fileobj=zipped, mode="w|", format=tarfile.PAX_FORMAT) as archive:
                for source, rel in entries:
                    if not source.resolve(strict=False).is_relative_to(root):
                        raise ValueError(f"path escapes source root: {rel}")
                    info = archive.gettarinfo(str(source), arcname=f"{root.name}/{rel}")
                    info.uid = info.gid = 0
                    info.uname = info.gname = ""
                    info.mtime = int(os.environ.get("SOURCE_DATE_EPOCH", "0"))
                    info.pax_headers = {}
                    if info.isfile():
                        with source.open("rb") as stream:
                            archive.addfile(info, stream)
                    else:
                        archive.addfile(info)
        os.replace(temporary, output)
    finally:
        if os.path.exists(temporary):
            os.unlink(temporary)


def check(root: Path, manifest: Path) -> int:
    """Read-only preflight: the same members() validation, no archive or output written."""
    try:
        entries = members(root.resolve(), manifest)
    except (OSError, ValueError) as error:
        print(f"FLAMEWM-SOURCE-CHECK: BLOCKED: {error}", file=sys.stderr)
        return 2
    print(f"FLAMEWM-SOURCE-CHECK: {len(entries)} source members and executable registry validated")
    return 0


if __name__ == "__main__":
    if len(sys.argv) == 4 and sys.argv[1] == "--check":
        raise SystemExit(check(Path(sys.argv[2]), Path(sys.argv[3])))
    if len(sys.argv) != 4:
        raise SystemExit("usage: package-source-archive ROOT MANIFEST OUTPUT | --check ROOT MANIFEST")
    write_archive(Path(sys.argv[1]), Path(sys.argv[2]), Path(sys.argv[3]))
