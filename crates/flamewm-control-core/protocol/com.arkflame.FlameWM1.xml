<!DOCTYPE node PUBLIC "-//freedesktop//DTD D-BUS Object Introspection 1.0//EN"
 "http://www.freedesktop.org/standards/dbus/1.0/introspect.dtd">
<node name="/com/arkflame/FlameWM1">
  <!-- Root -->
  <interface name="com.arkflame.FlameWM1">
    <method name="GetVersion">
      <arg name="version" type="s" direction="out"/>
    </method>
    <method name="GetCapabilities">
      <arg name="capabilities" type="as" direction="out"/>
    </method>
    <method name="GetShellBootstrap">
      <arg name="snapshot" type="a{sv}" direction="out"/>
    </method>
    <method name="Ping">
      <arg name="reply" type="s" direction="out"/>
    </method>
    <signal name="StartMenuToggleRequested"/>
    <signal name="LauncherToggleRequested"/>
    <signal name="WindowSwitcherChanged">
      <arg name="open" type="b"/>
      <arg name="immediate" type="b"/>
      <arg name="selected" type="u"/>
      <arg name="entries" type="aa{sv}"/>
    </signal>
  </interface>

  <!-- Windows -->
  <interface name="com.arkflame.FlameWM1.Windows">
    <method name="GetWindows">
      <arg name="windows" type="aa{sv}" direction="out"/>
    </method>
    <signal name="WindowsChanged">
      <arg name="revision" type="t"/>
    </signal>
    <signal name="WindowsSnapshotChanged">
      <arg name="revision" type="t"/>
      <arg name="windows" type="aa{sv}"/>
    </signal>
    <method name="ActivateWindow">
      <arg name="windowId" type="t" direction="in"/>
      <arg name="generation" type="t" direction="in"/>
    </method>
    <method name="MinimizeWindow">
      <arg name="windowId" type="t" direction="in"/>
      <arg name="generation" type="t" direction="in"/>
    </method>
    <method name="RestoreWindow">
      <arg name="windowId" type="t" direction="in"/>
      <arg name="generation" type="t" direction="in"/>
    </method>
    <method name="CloseWindow">
      <arg name="windowId" type="t" direction="in"/>
      <arg name="generation" type="t" direction="in"/>
    </method>
  </interface>

  <!-- Applications -->
  <interface name="com.arkflame.FlameWM1.Applications">
    <method name="GetApplications">
      <arg name="applications" type="aa{sv}" direction="out"/>
    </method>
    <method name="LaunchApplication">
      <arg name="appId" type="s" direction="in"/>
      <arg name="extraArgs" type="as" direction="in"/>
      <arg name="uris" type="as" direction="in"/>
    </method>
  </interface>

  <!-- Settings -->
  <interface name="com.arkflame.FlameWM1.Settings">
    <method name="GetSnapshot">
      <arg name="snapshot" type="a{sv}" direction="out"/>
    </method>
    <method name="Apply">
      <arg name="expectedRevision" type="t" direction="in"/>
      <arg name="changes" type="a{sv}" direction="in"/>
      <arg name="snapshot" type="a{sv}" direction="out"/>
    </method>
    <method name="ResetSection">
      <arg name="expectedRevision" type="t" direction="in"/>
      <arg name="section" type="s" direction="in"/>
      <arg name="snapshot" type="a{sv}" direction="out"/>
    </method>
    <signal name="SettingsChanged">
      <arg name="newRevision" type="t"/>
      <arg name="keys" type="as"/>
    </signal>
    <signal name="SettingsSnapshotChanged">
      <arg name="snapshot" type="a{sv}"/>
    </signal>
  </interface>

  <!-- Workspaces -->
  <interface name="com.arkflame.FlameWM1.Workspaces">
    <method name="GetSnapshot">
      <arg name="snapshot" type="a{sv}" direction="out"/>
    </method>
    <method name="Activate">
      <arg name="index" type="u" direction="in"/>
      <arg name="expectedRevision" type="t" direction="in"/>
    </method>
    <method name="InsertAfter">
      <arg name="index" type="u" direction="in"/>
      <arg name="expectedRevision" type="t" direction="in"/>
    </method>
    <method name="Remove">
      <arg name="index" type="u" direction="in"/>
      <arg name="expectedRevision" type="t" direction="in"/>
    </method>
    <signal name="WorkspacesChanged">
      <arg name="revision" type="t"/>
    </signal>
    <signal name="WorkspacesSnapshotChanged">
      <arg name="snapshot" type="a{sv}"/>
    </signal>
  </interface>

  <!-- Displays -->
  <interface name="com.arkflame.FlameWM1.Displays">
    <method name="GetSnapshot">
      <arg name="snapshot" type="a{sv}" direction="out"/>
    </method>
    <method name="BeginModeChange">
      <arg name="outputKey" type="s" direction="in"/>
      <arg name="modeId" type="t" direction="in"/>
      <arg name="generation" type="t" direction="in"/>
      <arg name="transaction" type="t" direction="out"/>
    </method>
    <method name="Keep">
      <arg name="transaction" type="t" direction="in"/>
    </method>
    <method name="Revert">
      <arg name="transaction" type="t" direction="in"/>
    </method>
    <method name="SetShellScale">
      <arg name="outputKey" type="s" direction="in"/>
      <arg name="percent" type="u" direction="in"/>
      <arg name="expectedRevision" type="t" direction="in"/>
    </method>
    <signal name="TopologyChanged">
      <arg name="generation" type="t"/>
    </signal>
    <signal name="DisplaysSnapshotChanged">
      <arg name="snapshot" type="a{sv}"/>
    </signal>
    <signal name="DisplayTransactionChanged">
      <arg name="transaction" type="t"/>
      <arg name="state" type="s"/>
      <arg name="deadlineMs" type="t"/>
    </signal>
  </interface>

  <!-- Shortcuts -->
  <interface name="com.arkflame.FlameWM1.Shortcuts">
    <method name="GetSnapshot">
      <arg name="snapshot" type="a{sv}" direction="out"/>
    </method>
    <method name="SetBinding">
      <arg name="action" type="s" direction="in"/>
      <arg name="binding" type="s" direction="in"/>
      <arg name="expectedRevision" type="t" direction="in"/>
    </method>
    <method name="ClearBinding">
      <arg name="action" type="s" direction="in"/>
      <arg name="expectedRevision" type="t" direction="in"/>
    </method>
    <method name="ResetBinding">
      <arg name="action" type="s" direction="in"/>
      <arg name="expectedRevision" type="t" direction="in"/>
    </method>
    <method name="BeginCapture">
      <arg name="action" type="s" direction="in"/>
      <arg name="expectedRevision" type="t" direction="in"/>
      <arg name="lease" type="t" direction="out"/>
    </method>
    <method name="EndCapture">
      <arg name="lease" type="t" direction="in"/>
    </method>
    <signal name="ShortcutsChanged">
      <arg name="revision" type="t"/>
    </signal>
  </interface>

  <!-- Panels -->
  <interface name="com.arkflame.FlameWM1.Panels">
    <method name="GetSnapshot">
      <arg name="snapshot" type="a{sv}" direction="out"/>
    </method>
    <method name="SetEdge">
      <arg name="outputKey" type="s" direction="in"/>
      <arg name="edge" type="s" direction="in"/>
      <arg name="expectedRevision" type="t" direction="in"/>
    </method>
    <method name="SetSize">
      <arg name="outputKey" type="s" direction="in"/>
      <arg name="size" type="u" direction="in"/>
      <arg name="expectedRevision" type="t" direction="in"/>
    </method>
    <method name="Pin">
      <arg name="appId" type="s" direction="in"/>
      <arg name="expectedRevision" type="t" direction="in"/>
    </method>
    <method name="Unpin">
      <arg name="appId" type="s" direction="in"/>
      <arg name="expectedRevision" type="t" direction="in"/>
    </method>
    <method name="Reorder">
      <arg name="entryId" type="s" direction="in"/>
      <arg name="index" type="u" direction="in"/>
      <arg name="expectedRevision" type="t" direction="in"/>
    </method>
    <signal name="PanelsChanged">
      <arg name="revision" type="t"/>
    </signal>
    <signal name="PanelsSnapshotChanged">
      <arg name="snapshot" type="a{sv}"/>
    </signal>
  </interface>

  <!-- Session -->
  <interface name="com.arkflame.FlameWM1.Session">
    <method name="GetCapabilities">
      <arg name="capabilities" type="as" direction="out"/>
    </method>
    <method name="Lock"/>
    <method name="LockPreview"/>
    <method name="Logout"/>
    <method name="Suspend"/>
    <method name="Reboot"/>
    <method name="Shutdown"/>
    <method name="ScreensaverPreview"/>
  </interface>

  <!-- System -->
  <interface name="com.arkflame.FlameWM1.System">
    <method name="GetSnapshot">
      <arg name="snapshot" type="a{sv}" direction="out"/>
    </method>
    <method name="SetWifiEnabled">
      <arg name="enabled" type="b" direction="in"/>
      <arg name="expectedRevision" type="t" direction="in"/>
    </method>
    <method name="ConnectKnown">
      <arg name="accessPointPath" type="s" direction="in"/>
      <arg name="expectedRevision" type="t" direction="in"/>
    </method>
    <method name="ConnectWifi">
      <arg name="accessPointPath" type="s" direction="in"/>
      <arg name="generation" type="t" direction="in"/>
      <arg name="expectedRevision" type="t" direction="in"/>
    </method>
    <method name="SubmitNetworkSecret">
      <arg name="requestId" type="t" direction="in"/>
      <arg name="generation" type="t" direction="in"/>
      <arg name="secret" type="s" direction="in"/>
      <arg name="expectedRevision" type="t" direction="in"/>
    </method>
    <method name="CancelNetworkSecret">
      <arg name="requestId" type="t" direction="in"/>
      <arg name="generation" type="t" direction="in"/>
      <arg name="expectedRevision" type="t" direction="in"/>
    </method>
    <method name="Disconnect"><arg name="expectedRevision" type="t" direction="in"/></method>
    <method name="Scan"><arg name="expectedRevision" type="t" direction="in"/></method>
    <method name="Play"><arg name="busName" type="s" direction="in"/><arg name="expectedRevision" type="t" direction="in"/></method>
    <method name="Pause"><arg name="busName" type="s" direction="in"/><arg name="expectedRevision" type="t" direction="in"/></method>
    <method name="PlayPause"><arg name="busName" type="s" direction="in"/><arg name="expectedRevision" type="t" direction="in"/></method>
    <method name="Next"><arg name="busName" type="s" direction="in"/><arg name="expectedRevision" type="t" direction="in"/></method>
    <method name="Previous"><arg name="busName" type="s" direction="in"/><arg name="expectedRevision" type="t" direction="in"/></method>
    <method name="SetVolume"><arg name="targetKind" type="s" direction="in"/><arg name="endpointKind" type="s" direction="in"/><arg name="id" type="u" direction="in"/><arg name="percent" type="u" direction="in"/><arg name="generation" type="t" direction="in"/><arg name="serverGeneration" type="t" direction="in"/><arg name="expectedRevision" type="t" direction="in"/></method>
    <method name="SetMute"><arg name="targetKind" type="s" direction="in"/><arg name="endpointKind" type="s" direction="in"/><arg name="id" type="u" direction="in"/><arg name="muted" type="b" direction="in"/><arg name="generation" type="t" direction="in"/><arg name="serverGeneration" type="t" direction="in"/><arg name="expectedRevision" type="t" direction="in"/></method>
    <method name="BatteryMenuOpened"><arg name="expectedRevision" type="t" direction="in"/></method>
    <method name="BatteryMenuClosed"><arg name="expectedRevision" type="t" direction="in"/></method>
    <signal name="SystemChanged">
      <arg name="revision" type="t"/>
    </signal>
    <signal name="SystemSnapshotChanged">
      <arg name="snapshot" type="a{sv}"/>
    </signal>
  </interface>
</node>
